<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Single assembly for the 1.7 technical experiments.
    All *.cs below this folder are compiled (feature workers add files, no csproj edits needed).
    The assembly is only loaded from 1.7/ via LoadFolders.xml so 1.6 never sees a .NET 10 binary.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WhisperOfTheForest</AssemblyName>
    <RootNamespace>WhisperOfTheForest</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <NoWarn>CS0436;CS0649;CS0169;CS0414;CS0162</NoWarn>

    <!-- Override on the command line when the game or workshop moves. -->
    <GameRoot Condition="'$(GameRoot)' == ''">E:/SteamLibrary/steamapps/common/RimWorld</GameRoot>
    <WorkshopRoot Condition="'$(WorkshopRoot)' == ''">E:/SteamLibrary/steamapps/workshop/content/294100</WorkshopRoot>
    <RimLumenRoot Condition="'$(RimLumenRoot)' == '' and Exists('C:/Users/81004/orca/RimLumen/1.7/Assemblies/RimLumen.Core.dll')">C:/Users/81004/orca/RimLumen</RimLumenRoot>
    <RimLumenRoot Condition="'$(RimLumenRoot)' == '' and Exists('$(GameRoot)/Mods/RimLumen/1.7/Assemblies/RimLumen.Core.dll')">$(GameRoot)/Mods/RimLumen</RimLumenRoot>
    <RimLumenRoot Condition="'$(RimLumenRoot)' == ''">$(WorkshopRoot)/3839499092</RimLumenRoot>

    <OutputPath>$(MSBuildThisFileDirectory)..\..\1.7\Assemblies\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game and engine assemblies: compile-time only, never copied into the repo. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameRoot)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(GameRoot)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(GameRoot)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameRoot)/com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Mod dependencies, per version (1.7 load folder only). -->
    <Reference Include="0Harmony">
      <HintPath>$(WorkshopRoot)/2009463077/1.7/Assemblies/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimUnity.Core">
      <HintPath>$(WorkshopRoot)/3819570122/1.7/Assemblies/RimUnity.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimUnity">
      <HintPath>$(WorkshopRoot)/3819570122/1.7/Assemblies/RimUnity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AlienRace">
      <HintPath>$(WorkshopRoot)/839005762/1.7/Assemblies/AlienRace.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimLumen.Core">
      <HintPath>$(RimLumenRoot)/1.7/Assemblies/RimLumen.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
