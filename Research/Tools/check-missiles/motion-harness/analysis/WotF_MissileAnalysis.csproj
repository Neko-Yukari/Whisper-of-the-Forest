<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Read-only analysis build for the two candidate missile profiles (low-turn explosive,
    high-turn slow healer). It compiles the production missile logic unchanged against the same
    minimal Verse shim as the main harness; nothing here ships or affects the mod.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WotF_MissileAnalysis</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <NoWarn>CS0649;CS0169;CS0414</NoWarn>
    <ModSource Condition="'$(ModSource)' == ''">$(MSBuildThisFileDirectory)../../../../Whisper-of-the-Forest/Source/WhisperOfTheForest</ModSource>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ModSource)/Missiles/ArcaneMissile.cs" Link="Production/ArcaneMissile.cs" />
    <Compile Include="$(ModSource)/Missiles/ArcaneMissileSettings.cs" Link="Production/ArcaneMissileSettings.cs" />
    <Compile Include="$(ModSource)/Missiles/ArcaneMissileDefs.cs" Link="Production/ArcaneMissileDefs.cs" />
    <Compile Include="$(ModSource)/Missiles/ArcaneMissileImpactWorker.cs" Link="Production/ArcaneMissileImpactWorker.cs" />
    <Compile Include="$(ModSource)/Missiles/ArcaneMissileImpactWorkers.cs" Link="Production/ArcaneMissileImpactWorkers.cs" />
    <Compile Include="$(ModSource)/Missiles/ArcaneMissileVisualSource.cs" Link="Production/ArcaneMissileVisualSource.cs" />
    <Compile Include="../Shims.cs" Link="Harness/Shims.cs" />
    <Compile Include="AnalysisProgram.cs" />
  </ItemGroup>

</Project>
