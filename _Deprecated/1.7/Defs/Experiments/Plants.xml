<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Instant maturity psycast. Real Royalty psycast: abilityClass stays RimWorld.Psycast (inherited
    from PsycastBase), so the gizmo, warmup, line of sight, psyfocus and neural heat all come from
    vanilla. The comp only accepts one immature spawned plant and sets Plant.Growth to 1.
    Casting is free so a lab pawn can repeat it; raise the statBases for normal play.
  -->
  <AbilityDef ParentName="PsycastBase" MayRequire="Ludeon.RimWorld.Royalty">
    <defName>WotF_MaturePlant</defName>
    <label>instantly mature plant</label>
    <description>Force a single immature plant to finish growing on the spot. Crops and trees both answer, but only growth changes: injuries, diseases, age and the def's harvest rules stay exactly as they were.</description>
    <level>1</level>
    <iconPath>Experiments/UI/TechLabIcon</iconPath>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <!-- Vanilla draws this bar over the target; disable it so no bar appears. -->
    <showCastingProgressBar>false</showCastingProgressBar>
    <aiCanUse>false</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <cooldownTicksRange>90~120</cooldownTicksRange>
    <statBases>
      <Ability_EntropyGain>0</Ability_EntropyGain>
      <Ability_PsyfocusCost>0</Ability_PsyfocusCost>
    </statBases>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <targetParams>
        <!-- Plants only: no empty ground, pawns, animals or buildings. -->
        <canTargetPawns>false</canTargetPawns>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetHumans>false</canTargetHumans>
        <canTargetMechs>false</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
        <canTargetLocations>false</canTargetLocations>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPlants>true</canTargetPlants>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="WhisperOfTheForest.Experimental.Abilities.CompProperties_AbilityWotFPlantGrowth" />
    </comps>
  </AbilityDef>

</Defs>
