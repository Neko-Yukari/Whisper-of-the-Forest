<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ApparelBase">
    <defName>WotF_TerrainStride</defName>
    <label>terrain stride mantle</label>
    <description>A light woodland mantle. On passable cells that require no door opening, it removes movement penalties from terrain, plants, rock chunks, furniture, crossable workbenches, snow and sand. It does not allow passage through walls or impassable water, and doors still open normally.</description>
    <thingClass>Apparel</thingClass>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Movement/TerrainStride</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>0.4</Mass>
      <WorkToMake>1200</WorkToMake>
      <Flammability>0.4</Flammability>
      <EquipDelay>1</EquipDelay>
    </statBases>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <smeltable>false</smeltable>
    <apparel>
      <!-- 技术/02-魔法实现.md (服饰分层表): 外披机动 is a Shell-layer mantle over shoulders and torso. -->
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>WotF_Elven</li>
        <li>WotF_CourtCloak</li>
      </tags>
      <wornGraphicPath>Movement/TerrainStride</wornGraphicPath>
      <countsAsClothingForNudity>true</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <developmentalStageFilter>Adult</developmentalStageFilter>
    </apparel>
  </ThingDef>

  <!--
    设定表把踏地披风列在「布/皮 + 活木」。不加 stuffCategories，用固定材料配方。
  -->
  <RecipeDef>
    <defName>WotF_MakeTerrainStride</defName>
    <label>make terrain stride mantle</label>
    <description>Weave a terrain stride mantle from cloth and living wood.</description>
    <jobString>Weaving a terrain stride mantle.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
    <skillRequirements>
      <Crafting>2</Crafting>
    </skillRequirements>
    <ingredients>
      <li>
        <filter><thingDefs><li>Cloth</li></thingDefs></filter>
        <count>40</count>
      </li>
      <li>
        <filter><thingDefs><li>WotF_LivingWood</li></thingDefs></filter>
        <count>10</count>
      </li>
    </ingredients>
    <products>
      <WotF_TerrainStride>1</WotF_TerrainStride>
    </products>
    <recipeUsers>
      <li>WotF_ManaWorkbench</li>
    </recipeUsers>
  </RecipeDef>

</Defs>
