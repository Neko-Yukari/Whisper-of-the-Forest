<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Movement experiments. Both items are normal wearables:
      * TerrainStride sits in the Middle layer on the Torso group (shirt slot).
      * BlinkStride sits in the Belt layer on the Waist group (utility slot).
    Different layer + body part group means both can be worn at the same time;
    the cost is that TerrainStride competes with a normal shirt.
    No recipe is defined: the experiment Lab hands them out.
  -->
  <ThingDef ParentName="ApparelBase">
    <defName>WotF_TerrainStride</defName>
    <label>terrain stride mantle</label>
    <description>A light experiment mantle. While worn, the terrain underfoot no longer adds its own movement cost: mud, marsh and rough ground are walked at normal speed. Walls, closed doors, buildings and other real obstacles still block and still cost what they cost.</description>
    <thingClass>Apparel</thingClass>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Movement/TerrainStride</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>0.4</Mass>
      <WorkToMake>1200</WorkToMake>
      <Flammability>0.4</Flammability>
      <EquipDelay>1</EquipDelay>
    </statBases>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <!-- Inherited smeltable=true with no costList/smeltProducts trips ThingDef.ConfigErrors;
         experiment items are Lab-granted placeholders, so they simply cannot be smelted. -->
    <smeltable>false</smeltable>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>Middle</li>
      </layers>
      <wornGraphicPath>Movement/TerrainStride</wornGraphicPath>
      <countsAsClothingForNudity>true</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <developmentalStageFilter>Adult</developmentalStageFilter>
    </apparel>
    <comps>
      <li Class="WhisperOfTheForest.Movement.CompProperties_StrideLog" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="ApparelBase">
    <defName>WotF_BlinkStride</defName>
    <label>blink stride sash</label>
    <description>A light experiment sash. While worn, the bearer walks one cell of their own path and then steps instantly to the next cell of that same path, alternating. The hop never leaves the calculated route: walls, closed doors, illegal diagonals, occupied cells and the final cell of the path are still walked normally.</description>
    <thingClass>Apparel</thingClass>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Movement/BlinkStride</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>0.3</Mass>
      <WorkToMake>1200</WorkToMake>
      <Flammability>0.4</Flammability>
      <EquipDelay>1</EquipDelay>
    </statBases>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <!-- Same reason as TerrainStride: no materials exist to smelt back. -->
    <smeltable>false</smeltable>
    <apparel>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <wornGraphicPath>Movement/BlinkStride</wornGraphicPath>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <tags>
        <li>BeltDefense</li>
      </tags>
    </apparel>
    <comps>
      <li Class="WhisperOfTheForest.Movement.CompProperties_StrideLog" />
    </comps>
  </ThingDef>

</Defs>
