      <Flammability>0</Flammability>
      <StuffPower_Armor_Sharp>1.14</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.65</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.85</StuffPower_Armor_Heat>
