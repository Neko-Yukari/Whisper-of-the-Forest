<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    A bloodline pawn fixing a broken-down building: chalk dust and knocked-off wood instead of
    the vanilla welding sparks. Only JobDriver_FixBrokenDownBuilding uses this effecter.
  -->
  <EffecterDef>
    <defName>WotF_ElfRepair</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_Sustainer</subEffecterClass>
        <soundDef>Interact_ConstructWood</soundDef>
        <ticksBeforeSustainerStart>20</ticksBeforeSustainerStart>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>DustPuff</fleckDef>
        <spawnLocType>BetweenTouchingCells</spawnLocType>
        <positionLerpFactor>0.49</positionLerpFactor>
        <color>(0.94, 0.94, 0.86, 0.75)</color>
        <chancePerTick>0.06</chancePerTick>
        <scale>0.5~0.9</scale>
        <rotationRate>-30~30</rotationRate>
        <speed>0.4~1.2</speed>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>WoodBit</fleckDef>
        <spawnLocType>BetweenTouchingCells</spawnLocType>
        <positionLerpFactor>0.49</positionLerpFactor>
        <chancePerTick>0.09</chancePerTick>
        <scale>0.45~0.75</scale>
        <rotationRate>-180~180</rotationRate>
        <speed>2~5</speed>
        <angle>0~360</angle>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
      </li>
    </children>
  </EffecterDef>

</Defs>
