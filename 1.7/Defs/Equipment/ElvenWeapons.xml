<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Elven longsword and living-wood longbow (技术/02-魔法实现.md:126-142).

    Both are ordinary vanilla equivalents with one comp pair added: CompEnchantedEquipment holds the
    inscribed spells, and CompEnchantedWeapon is a CompEquippable subclass so an equipped weapon can
    contribute the mithril slot switch to the pawn's gizmo row. Because that replaces the inherited
    CompEquippable, comps are declared with Inherit="False" and every comp the vanilla parent added is
    repeated here — the same reason WotF_SpellStaff does it (1.7/Defs/Equipment/SpellStaff.xml).

    Combat numbers are copied verbatim from the vanilla Def named above each block. Fields that would
    pull the item into vanilla generation (weaponTags used by pawn kind selection, thingSetMakerTags,
    relicChance) are not copied: the elven sword is not meant to replace the vanilla longsword in
    every raid and loot table.

    triggerChance 1 / triggerCooldownTicks 0: a weapon fires on every hit it lands (no per-hit roll,
    no cooldown); the reaction below the staff's own mana gate.
  -->

  <!-- 参照原版 MeleeWeapon_LongSword（Data/Core/Defs/ThingDefs_Misc/Weapons/MeleeMedieval.xml）。 -->
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>WotF_ElvenLongsword</defName>
    <label>elven longsword</label>
    <description>A longsword of the forest court, balanced for a slash or a thrust. A spell inscribed into its hilt is released into whatever the blade bites.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/ElvenLongsword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <weaponTags>
      <li>WotF_ElvenSword</li>
    </weaponTags>
    <tradeTags Inherit="False">
      <li>WeaponMelee</li>
    </tradeTags>
    <costStuffCount>100</costStuffCount>
    <statBases>
      <WorkToMake>18000</WorkToMake>
      <Mass>2</Mass>
    </statBases>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>23</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>23</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>WotF_ManaWorkbench</li>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>410</displayPriority>
    </recipeMaker>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponMelee</nameMaker>
        <descriptionMaker>ArtDescription_WeaponMelee</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
      <li>
        <compClass>WhisperOfTheForest.Equipment.CompEnchantedWeapon</compClass>
      </li>
      <li Class="WhisperOfTheForest.Equipment.CompProperties_EnchantedEquipment">
        <slots>1</slots>
        <mithrilSlots>2</mithrilSlots>
        <mithrilStuff>WotF_Mithril</mithrilStuff>
        <mithrilCostFactor>0.7</mithrilCostFactor>
        <triggerChance>1</triggerChance>
        <triggerCooldownTicks>0</triggerCooldownTicks>
      </li>
    </comps>
  </ThingDef>

  <!--
    参照原版 Bow_Great（Data/Core/Defs/ThingDefs_Misc/Weapons/RangedNeolithic.xml）。

    RangedWeapon_Cooldown 1.35 = 原版 1.5 × 0.90（设定：活木长弓射速 +10%）。写在这里而不是活木材质上：
    材质是 Woody 类，挂着任何木制武器（含法杖），倍率会溢出到别的武器上。
    costList 只有活木：设定里这把弓就是活木弓，不走 stuffCategories，所以它也永远只有 1 个注法槽。
  -->
  <ThingDef ParentName="BaseWeaponNeolithic">
    <defName>WotF_ElvenLongbow</defName>
    <label>living-wood longbow</label>
    <description>A longbow cut and bent from a single limb of living wood, strung with gut. It draws fast and quiet, and a spell inscribed into the grip rides every arrow it looses.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/ElvenLongbow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Bow_Large</soundInteract>
    <costList>
      <WotF_LivingWood>30</WotF_LivingWood>
    </costList>
    <statBases>
      <WorkToMake>9000</WorkToMake>
      <Mass>3.0</Mass>
      <AccuracyTouch>0.65</AccuracyTouch>
      <AccuracyShort>0.85</AccuracyShort>
      <AccuracyMedium>0.75</AccuracyMedium>
      <AccuracyLong>0.50</AccuracyLong>
      <RangedWeapon_Cooldown>1.35</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags Inherit="False">
      <li>WotF_ElvenBow</li>
    </weaponTags>
    <tradeTags Inherit="False">
      <li>WeaponRanged</li>
    </tradeTags>
    <weaponClasses>
      <li>Ranged</li>
      <li>RangedHeavy</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>WotF_Projectile_ElvenArrow</defaultProjectile>
        <warmupTime>2.0</warmupTime>
        <range>29.9</range>
        <soundCast>Bow_Large</soundCast>
      </li>
    </verbs>
    <tools>
      <li>
        <label>limb</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>WotF_ManaWorkbench</li>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>530</displayPriority>
    </recipeMaker>
    <rotateInShelves>false</rotateInShelves>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li>
        <compClass>WhisperOfTheForest.Equipment.CompEnchantedWeapon</compClass>
      </li>
      <li Class="WhisperOfTheForest.Equipment.CompProperties_EnchantedEquipment">
        <slots>1</slots>
        <mithrilSlots>1</mithrilSlots>
        <mithrilStuff>WotF_Mithril</mithrilStuff>
        <mithrilCostFactor>0.7</mithrilCostFactor>
        <triggerChance>1</triggerChance>
        <triggerCooldownTicks>0</triggerCooldownTicks>
      </li>
    </comps>
  </ThingDef>

  <!--
    参照原版 Arrow_Great（Data/Core/Defs/ThingDefs_Misc/Weapons/RangedNeolithic.xml）：同为
    BaseProjectileNeolithic 下的 Bullet，只把 thingClass 换成会在命中后回头通知弓的派生类。
  -->
  <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>WotF_Projectile_ElvenArrow</defName>
    <label>elven arrow</label>
    <thingClass>WhisperOfTheForest.Equipment.Projectile_ElvenArrow</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Arrow_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Arrow</damageDef>
      <damageAmountBase>17</damageAmountBase>
      <stoppingPower>1.5</stoppingPower>
      <armorPenetrationBase>0.15</armorPenetrationBase>
      <speed>49</speed>
    </projectile>
  </ThingDef>

</Defs>
