<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ApparelLayerDef>
    <defName>WotF_SpellbookLayer</defName>
    <label>spellbook</label>
    <drawOrder>310</drawOrder>
  </ApparelLayerDef>

  <!-- Spells belong to the pawn. All ten bookmarks open with any worn book; book tier limits glyphs per spell chain. -->
  <ThingDef Name="WotF_SpellbookBase" ParentName="ApparelBase" Abstract="True">
    <thingClass>Apparel</thingClass>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Spellbook/BookCover</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>1</Mass>
      <MarketValue>300</MarketValue>
      <Flammability>1</Flammability>
      <EquipDelay>1</EquipDelay>
    </statBases>
    <smeltable>false</smeltable>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups><li>Waist</li></bodyPartGroups>
      <layers><li>WotF_SpellbookLayer</li></layers>
      <developmentalStageFilter>Adult</developmentalStageFilter>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="WotF_SpellbookBase">
    <defName>WotF_Spellbook_Apprentice</defName>
    <label>apprentice spellbook</label>
    <description>A forest spellbook worn at the hip. Opens all ten spell bookmarks with a chain limit of 4 glyphs per spell, and strengthens the wearer's mana. It cannot hold super runes.</description>
    <equippedStatOffsets>
      <WotF_ManaMax>20</WotF_ManaMax>
      <WotF_ManaRegen>0.5</WotF_ManaRegen>
    </equippedStatOffsets>
    <modExtensions>
      <li Class="WhisperOfTheForest.Spells.SpellbookExtension">
        <maxGlyphs>4</maxGlyphs>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="WotF_SpellbookBase">
    <defName>WotF_Spellbook_Adept</defName>
    <label>adept spellbook</label>
    <description>An advanced forest spellbook. Opens all ten spell bookmarks with a chain limit of 7 glyphs per spell, and strengthens the wearer's mana. It cannot hold super runes.</description>
    <graphicData><color>(0.45,0.85,0.65)</color></graphicData>
    <equippedStatOffsets>
      <WotF_ManaMax>45</WotF_ManaMax>
      <WotF_ManaRegen>1.2</WotF_ManaRegen>
    </equippedStatOffsets>
    <modExtensions>
      <li Class="WhisperOfTheForest.Spells.SpellbookExtension">
        <maxGlyphs>7</maxGlyphs>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="WotF_SpellbookBase">
    <defName>WotF_Spellbook_Archmage</defName>
    <label>starlight codex</label>
    <description>A starlight codex. Opens all ten spell bookmarks with a chain limit of 10 glyphs per spell, and can hold super runes. Casting a super spell also requires a staff in the main hand.</description>
    <graphicData><color>(0.7,0.6,1)</color></graphicData>
    <equippedStatOffsets>
      <WotF_ManaMax>80</WotF_ManaMax>
      <WotF_ManaRegen>2.5</WotF_ManaRegen>
    </equippedStatOffsets>
    <modExtensions>
      <li Class="WhisperOfTheForest.Spells.SpellbookExtension">
        <maxGlyphs>10</maxGlyphs>
        <allowsSuperGlyphs>true</allowsSuperGlyphs>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
