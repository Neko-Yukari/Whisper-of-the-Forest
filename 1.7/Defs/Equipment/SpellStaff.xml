<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Unified spell staves: both the two-handed spell staff and the one-handed offhand spell wand
    run through CompSpellStaff + Verb_CastSpellStaff. All tunable differences (handedness, super-rune
    support, shield-belt compatibility, range/windup scaling, material resonance curves and caps)
    live on CompProperties_SpellStaff below.

    warmupTime is 0 because windup belongs to the casting service (scaled by windupFactor).
    range is the fallback before a bookmark is chosen; Verb_CastSpellStaff.EffectiveRange keeps
    verbProps.range in step with the selected bookmark scaled by rangeFactor.
  -->
  <ThingDef ParentName="BaseGun">
    <defName>WotF_SpellStaff</defName>
    <label>spell staff</label>
    <description>A full-length, two-handed spell staff — properly a staff rather than a quick one-handed wand, even if colonists casually call both "staves". Steadied with both hands, it channels a spellbook bookmark at full reach, amplifies material resonance to higher ceilings, and anchors super runes; in return it cannot be fired while wearing a ranged-blocking shield belt. Without a saved spell in its chosen bookmark it cannot attack.</description>
    <thingClass>ThingWithComps</thingClass>
    <equipmentType>Primary</equipmentType>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Equipment/SpellStaff</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>2400</WorkToMake>
      <Mass>2.5</Mass>
      <!-- 2 s: weapon attack cycle matching WotF_SpellTuning.cooldownTicks. -->
      <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Leathery</li>
    </stuffCategories>
    <costStuffCount>25</costStuffCount>
    <smeltable>false</smeltable>
    <weaponTags>
      <li>WotF_ElvenStaff</li>
    </weaponTags>
    <weaponClasses>
      <li>Ranged</li>
      <li>Ultratech</li>
    </weaponClasses>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <recipeUsers>
        <li>WotF_ManaWorkbench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <researchPrerequisite>WotF_Research_AltarT2</researchPrerequisite>
      <displayPriority>540</displayPriority>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>WhisperOfTheForest.Equipment.Verb_CastSpellStaff</verbClass>
        <label>cast</label>
        <isPrimary>true</isPrimary>
        <hasStandardCommand>true</hasStandardCommand>
        <ai_IsWeapon>true</ai_IsWeapon>
        <warmupTime>0</warmupTime>
        <range>24.9</range>
        <requireLineOfSight>false</requireLineOfSight>
        <targetParams>
          <canTargetPawns>true</canTargetPawns>
          <canTargetAnimals>true</canTargetAnimals>
          <canTargetHumans>true</canTargetHumans>
          <canTargetMechs>true</canTargetMechs>
          <canTargetSubhumans>true</canTargetSubhumans>
          <canTargetBuildings>true</canTargetBuildings>
          <canTargetPlants>true</canTargetPlants>
          <canTargetLocations>true</canTargetLocations>
          <canTargetSelf>false</canTargetSelf>
          <neverTargetIncapacitated>false</neverTargetIncapacitated>
        </targetParams>
      </li>
    </verbs>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li Class="WhisperOfTheForest.Equipment.CompProperties_SpellStaff">
        <isOneHanded>false</isOneHanded>
        <allowsSuperGlyphs>true</allowsSuperGlyphs>
        <allowsShieldBelt>false</allowsShieldBelt>
        <rangeFactor>1.0</rangeFactor>
        <windupFactor>1.0</windupFactor>
        <spellPowerFactor>1.05</spellPowerFactor>
        <bluntArmorCostReduction>0.40</bluntArmorCostReduction>
        <minManaFactor>0.60</minManaFactor>
        <heatArmorDurationBonus>0.20</heatArmorDurationBonus>
        <maxDurationFactor>1.75</maxDurationFactor>
        <maxDamageFactor>1.50</maxDamageFactor>
      </li>
    </comps>
  </ThingDef>

  <!--
    One-handed offhand spell wand (equipmentType = None): occupies its own offhand slot enforced
    by Patch_OffhandWand so it never displaces a Primary weapon. Solo-wielded (Primary == null) it
    auto-attacks like a normal ranged weapon; paired with a Primary weapon (e.g. elven longsword)
    it fires manually through its gizmo, and it casts cleanly through shield belts.
  -->
  <ThingDef ParentName="BaseGun">
    <defName>WotF_SpellWand</defName>
    <label>spell wand</label>
    <description>People keep calling it a "short spell staff", though by proper fantasy convention this nimble one-handed focus is strictly a wand, not a two-handed staff. Worn in the offhand without displacing a primary weapon, it can auto-cast when carried alone or fire on command alongside a blade and a shield belt — trading reach, material ceilings and super-rune support for rapid windup and compact handling.</description>
    <thingClass>ThingWithComps</thingClass>
    <equipmentType>None</equipmentType>
    <techLevel>Neolithic</techLevel>
    <graphicData>
      <texPath>Equipment/SpellStaffShort</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>1200</WorkToMake>
      <Mass>0.9</Mass>
      <RangedWeapon_Cooldown>1.1</RangedWeapon_Cooldown>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>12</costStuffCount>
    <smeltable>false</smeltable>
    <weaponTags>
      <li>WotF_ElvenWand</li>
    </weaponTags>
    <weaponClasses>
      <li>Ranged</li>
    </weaponClasses>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers>
        <li>CraftingSpot</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <displayPriority>535</displayPriority>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>WhisperOfTheForest.Equipment.Verb_CastSpellStaff</verbClass>
        <label>cast</label>
        <isPrimary>true</isPrimary>
        <hasStandardCommand>true</hasStandardCommand>
        <ai_IsWeapon>true</ai_IsWeapon>
        <warmupTime>0</warmupTime>
        <range>15.9</range>
        <requireLineOfSight>false</requireLineOfSight>
        <targetParams>
          <canTargetPawns>true</canTargetPawns>
          <canTargetAnimals>true</canTargetAnimals>
          <canTargetHumans>true</canTargetHumans>
          <canTargetMechs>true</canTargetMechs>
          <canTargetSubhumans>true</canTargetSubhumans>
          <canTargetBuildings>true</canTargetBuildings>
          <canTargetPlants>true</canTargetPlants>
          <canTargetLocations>true</canTargetLocations>
          <canTargetSelf>false</canTargetSelf>
          <neverTargetIncapacitated>false</neverTargetIncapacitated>
        </targetParams>
      </li>
    </verbs>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li Class="WhisperOfTheForest.Equipment.CompProperties_SpellStaff">
        <isOneHanded>true</isOneHanded>
        <allowsSuperGlyphs>false</allowsSuperGlyphs>
        <allowsShieldBelt>true</allowsShieldBelt>
        <rangeFactor>0.64</rangeFactor>
        <windupFactor>0.70</windupFactor>
        <spellPowerFactor>0.80</spellPowerFactor>
        <bluntArmorCostReduction>0.20</bluntArmorCostReduction>
        <minManaFactor>0.85</minManaFactor>
        <heatArmorDurationBonus>0.10</heatArmorDurationBonus>
        <maxDurationFactor>1.20</maxDurationFactor>
        <maxDamageFactor>1.15</maxDamageFactor>
      </li>
    </comps>
  </ThingDef>

</Defs>
