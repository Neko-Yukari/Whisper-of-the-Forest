<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Prototype spell staff.

    It is an ordinary ranged weapon (equipmentType Primary, a real verb, a standard attack
    command), but the verb does not launch anything: Verb_CastSpellStaff hands the chosen
    spellbook bookmark to the same SpellService.TryCast entry point the book gizmo uses. The
    casting system therefore owns windup, channel, recovery, cooldown and the payload.

    Numbers that belong to the casting system (range, cooldown, payload) are NOT copied here:
      * range is the fallback before a bookmark is chosen; once EffectiveRange runs it clones this
        VerbProperties and keeps range in step with the selected bookmark, because both the range
        test and CastPositionFinder read verbProps.range as well as EffectiveRange;
      * RangedWeapon_Cooldown is the attack cycle of the weapon. It is set to the same 2 s as the
        book's WotF_SpellTuning.cooldownTicks so a drafted attack order retries at the same pace
        the casting service allows another cast. The casting service stays the authority: if the
        two ever differ, it refuses earlier or later, never the other way round.
    warmupTime is 0 because the staff's windup is the spell's own.
  -->
  <ThingDef ParentName="BaseGun">
    <defName>WotF_SpellStaff</defName>
    <label>spell staff</label>
    <description>A prototype staff that casts instead of shooting. Its attack casts the spellbook bookmark chosen on its gizmo; the staff remembers the slot, not a copy, so editing that page changes what it casts. Without a saved spell it cannot attack.</description>
    <thingClass>ThingWithComps</thingClass>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Equipment/SpellStaff</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>2.5</Mass>
      <!-- 2 s: the weapon's own attack cycle, matching WotF_SpellTuning.cooldownTicks. -->
      <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
    </statBases>
    <!--
      Stuffable on purpose: the material is the third input of the staff, next to the rune chain
      and the book. Every stuff category the game already uses works; the material's vanilla
      armour stats are mapped to mana, duration and damage by WotF_SpellTuning.
    -->
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Leathery</li>
    </stuffCategories>
    <costStuffCount>20</costStuffCount>
    <!-- Lab-granted placeholder, like the movement experiment items: nothing to smelt back. -->
    <smeltable>false</smeltable>
    <weaponClasses>
      <li>Ranged</li>
      <li>Ultratech</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>WhisperOfTheForest.Equipment.Verb_CastSpellStaff</verbClass>
        <label>cast</label>
        <isPrimary>true</isPrimary>
        <hasStandardCommand>true</hasStandardCommand>
        <ai_IsWeapon>true</ai_IsWeapon>
        <warmupTime>0</warmupTime>
        <range>24.9</range>
        <!-- The spell decides reach and line of sight per form; the verb checks them itself. -->
        <requireLineOfSight>false</requireLineOfSight>
        <!--
          Permissive on purpose: the per-spell filter (harm/heal/grow/explosion/railgun) is built
          from the compiled plan and returned by Verb_CastSpellStaff.targetParams, exactly like the
          book's cast gizmo. This list only matters in the moment before a bookmark is chosen.
        -->
        <targetParams>
          <canTargetPawns>true</canTargetPawns>
          <canTargetAnimals>true</canTargetAnimals>
          <canTargetHumans>true</canTargetHumans>
          <canTargetMechs>true</canTargetMechs>
          <canTargetSubhumans>true</canTargetSubhumans>
          <canTargetBuildings>true</canTargetBuildings>
          <canTargetPlants>true</canTargetPlants>
          <canTargetLocations>true</canTargetLocations>
          <canTargetSelf>false</canTargetSelf>
          <neverTargetIncapacitated>false</neverTargetIncapacitated>
        </targetParams>
      </li>
    </verbs>
    <!--
      Comps are declared without inheritance because the equipment comp itself is replaced:
      CompSpellStaff derives from CompEquippable, which is what lets an equipped weapon contribute
      the slot-selection gizmo to the pawn. CompProperties_Equippable does not exist as a separate
      type in 1.7; a plain CompProperties entry with a compClass is how vanilla declares it.

      CompProperties_Styleable must stay: BaseWeapon declares it for every weapon, and the IdeoRelic
      precept's available-things list validates that a listed weapon has it. Dropping it logged
      "Config error in IdeoRelic: ThingDef WotF_SpellStaff ... missing CompStyleable" at load.
    -->
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li>
        <compClass>WhisperOfTheForest.Equipment.CompSpellStaff</compClass>
      </li>
    </comps>
  </ThingDef>

  <!--
    Short staff: a cheap, single-purpose short-range weapon for breaking a skip-abduction ritual.
    Its verb accepts only pawns that are currently participants in a psychic ritual, and the
    C# side narrows that to the two skip-abduction defs. A hit stuns every assigned participant
    for stunTicks and then cancels the ritual. It is not a general-purpose weapon.
  -->
  <ThingDef ParentName="BaseGun">
    <defName>WotF_SpellStaffShort</defName>
    <label>short spell staff</label>
    <description>A short, plain staff carried for one job: breaking a ritual that reaches into the colony from outside. Its strike only lands on someone taking part in a psychic ritual, and a hit stuns the participants and cancels a skip abduction.</description>
    <thingClass>ThingWithComps</thingClass>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Equipment/SpellStaffShort</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>1.5</Mass>
      <RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown>
    </statBases>
    <smeltable>false</smeltable>
    <weaponClasses>
      <li>Ranged</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>WhisperOfTheForest.Equipment.Verb_DisruptPsychicRitual</verbClass>
        <label>disrupt ritual</label>
        <isPrimary>true</isPrimary>
        <hasStandardCommand>true</hasStandardCommand>
        <warmupTime>0.2</warmupTime>
        <range>6.9</range>
        <requireLineOfSight>true</requireLineOfSight>
        <targetParams>
          <canTargetPawns>true</canTargetPawns>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetHumans>true</canTargetHumans>
          <canTargetMechs>false</canTargetMechs>
          <canTargetSubhumans>true</canTargetSubhumans>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetPlants>false</canTargetPlants>
          <canTargetLocations>false</canTargetLocations>
          <canTargetSelf>false</canTargetSelf>
          <neverTargetIncapacitated>false</neverTargetIncapacitated>
        </targetParams>
      </li>
    </verbs>
    <comps>
      <li Class="WhisperOfTheForest.Equipment.CompProperties_ShortStaff">
        <stunTicks>600</stunTicks>
      </li>
    </comps>
  </ThingDef>

  <RecipeDef>
    <defName>WotF_MakeShortSpellStaff</defName>
    <label>make short spell staff</label>
    <description>Craft a short staff for disrupting skip-abduction rituals.</description>
    <jobString>making a short spell staff.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <workAmount>1200</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
    </ingredients>
    <products>
      <WotF_SpellStaffShort>1</WotF_SpellStaffShort>
    </products>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
  </RecipeDef>

</Defs>
