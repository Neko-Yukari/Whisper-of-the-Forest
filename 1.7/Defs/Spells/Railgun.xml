<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The railgun supra rune, presented via RimLumen Layer 15 HDR geometry + L2 corridor particles/lights.
    Everything visual and auditory lives on WotF_Vfx_Railgun; the rune carries only spell mechanics.
  -->

  <WhisperOfTheForest.Spells.SpellGlyphDef>
    <defName>WotF_Form_Railgun</defName>
    <theme>WotF_Theme_HoloStorm</theme>
    <combatLogRules>WotF_CombatLog_Railgun</combatLogRules>
    <targets>
      <li>Humanlike</li>
      <li>Animal</li>
      <li>Mechanoid</li>
      <li>Entity</li>
      <li>Building</li>
      <li>Rock</li>
      <li>Plant</li>
      <li>Item</li>
      <li>Cell</li>
    </targets>
    <label>railgun</label>
    <description>A single rune that is a complete spell: it charges for a moment and then fires one straight shot through everything in its path, walls and mountains included. Nobody in the line is spared, the caster excepted.</description>
    <kind>Super</kind>
    <requiresUnlock>true</requiresUnlock>
    <compatibleAugments />
    <windupTicks>0</windupTicks>
    <channelTicks>90</channelTicks>
    <recoveryTicks>25</recoveryTicks>
    <iconPath>Spellbook/Glyphs/WotF_Form_Railgun</iconPath>
    <railgun>
      <damage>120</damage>
      <armorPenetration>0.5</armorPenetration>
      <hitWidth>2.5</hitWidth>
      <range>0</range>
      <vfxDef>WotF_Vfx_Railgun</vfxDef>
    </railgun>
    <manaCost>80</manaCost>
    <entropyCost>40</entropyCost>
    <experience>0</experience>
  </WhisperOfTheForest.Spells.SpellGlyphDef>

  <WhisperOfTheForest.Vfx.RailgunLumenVfxDef>
    <defName>WotF_Vfx_Railgun</defName>
    <label>railgun effect (RimLumen)</label>
    <workerClass>WhisperOfTheForest.Vfx.RailgunLumenVfxWorker</workerClass>
    <lifetime>FixedDuration</lifetime>

    <!-- Charge phase: front-of-caster plasma implosion with 2.5D Pawn silhouette occlusion -->
    <chargeOffsetCells>0.48</chargeOffsetCells>
    <wallClearanceMargin>0.18</wallClearanceMargin>
    <backAltitudeY>7.95</backAltitudeY>
    <frontAltitudeY>9.45</frontAltitudeY>
    <zTransitionHalf>0.06</zTransitionHalf>
    <chargeOriginHeightCells>0</chargeOriginHeightCells>
    <chargeRadiusCells>1.02</chargeRadiusCells>
    <chargeSpindleHalfHeight>0.72</chargeSpindleHalfHeight>
    <chargeBaseRingThickness>0.075</chargeBaseRingThickness>
    <chargeFunnelHeightCells>0.66</chargeFunnelHeightCells>
    <chargeVortexArms>4</chargeVortexArms>
    <chargeBoltCount>4</chargeBoltCount>
    <chargeColor>#38C6FF</chargeColor>
    <chargeCoreColor>#FFF8E0</chargeCoreColor>
    <chargeIntensity>1.25</chargeIntensity>
    <chargePulseHz>3.6</chargePulseHz>
    <chargeLumenEffectId>NekoYukari.WhisperOfTheForest:RailgunCharge</chargeLumenEffectId>
    <chargeSound>WotF_Sound_Railgun_Charge</chargeSound>

    <!-- Fire phase: HDR white-hot core + warm gold glow + 0.9s quadratic heat linger -->
    <beamAltitudeY>9.45</beamAltitudeY>
    <coreWidthCells>0.58</coreWidthCells>
    <coreColor>#FFFDF4</coreColor>
    <coreIntensity>1.65</coreIntensity>
    <glowWidthCells>2.25</glowWidthCells>
    <glowColor>#FFB03A</glowColor>
    <glowIntensity>1.05</glowIntensity>
    <afterglowColor>#E5A93B</afterglowColor>
    <afterglowIntensity>0.75</afterglowIntensity>
    <beamHoldSeconds>0.60</beamHoldSeconds>
    <beamFadeSeconds>0.70</beamFadeSeconds>
    <glowLingerSeconds>0.90</glowLingerSeconds>
    <ribbonEdgePower>1.65</ribbonEdgePower>
    <muzzleFlareRadius>1.25</muzzleFlareRadius>

    <!-- Seven independent re-striking jagged lightning bolts -->
    <arcColor>#FFF3C6</arcColor>
    <arcIntensity>1.40</arcIntensity>
    <arcCount>7</arcCount>
    <arcMinLengthCells>3</arcMinLengthCells>
    <arcMaxLengthCells>9</arcMaxLengthCells>
    <arcSegmentsPerCell>2.2</arcSegmentsPerCell>
    <arcMaxSegments>24</arcMaxSegments>
    <arcRadiusCells>1.15</arcRadiusCells>
    <arcJitterCells>0.45</arcJitterCells>
    <arcAngleJitterDegrees>55</arcAngleJitterDegrees>
    <arcThicknessCells>0.10</arcThicknessCells>
    <arcLifeSeconds>0.12</arcLifeSeconds>
    <arcGapSeconds>0.08</arcGapSeconds>

    <!-- Sixteen travelling 30-degree elliptical shock and re-ionisation rings -->
    <ringMode>Ellipse30</ringMode>
    <ringCount>16</ringCount>
    <ringSegments>48</ringSegments>
    <ringShockArrivalFraction>0.75</ringShockArrivalFraction>
    <ringMainPulseSeconds>0.50</ringMainPulseSeconds>
    <ringPulseRise>0.15</ringPulseRise>
    <ringPulseFall>0.75</ringPulseFall>
    <ringStartRadiusCells>1.45</ringStartRadiusCells>
    <ringMainEndRadiusCells>5.20</ringMainEndRadiusCells>
    <ringFlashChance>0.45</ringFlashChance>
    <ringFlashDelaySeconds>0.12</ringFlashDelaySeconds>
    <ringFlashSeconds>0.18</ringFlashSeconds>
    <ringFlashRadiusCells>3.20</ringFlashRadiusCells>
    <ringThicknessCells>0.15</ringThicknessCells>
    <ringColor>#00B4D8</ringColor>
    <ringSecondaryColor>#FCE29C</ringSecondaryColor>
    <ringIntensity>1.25</ringIntensity>
    <ringMainIntensityScale>1.25</ringMainIntensityScale>
    <ringFlashIntensityScale>0.60</ringFlashIntensityScale>
    <ringEllipseRatio>0.50</ringEllipseRatio>

    <!-- RimLumen L2 corridor sparks/embers + native screenDim + GlowGrid lights + layered fire sound -->
    <fireOriginHeightCells>0</fireOriginHeightCells>
    <fireLumenEffectId>NekoYukari.WhisperOfTheForest:RailgunFire</fireLumenEffectId>
    <fireSound>WotF_Sound_Railgun_Fire</fireSound>
  </WhisperOfTheForest.Vfx.RailgunLumenVfxDef>

</Defs>
