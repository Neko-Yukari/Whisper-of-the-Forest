  <!-- ============================================================ Tuning -->

  <!--
    The numbers that belong to the book and the caster, not to a rune. Ranges, darts, orbs, radii and
    armour penetration live on the glyph that owns them.
  -->
  <WhisperOfTheForest.Spells.SpellTuningDef>
    <defName>WotF_SpellTuning</defName>
    <label>spellbook tuning</label>
    <maxGlyphs>10</maxGlyphs>
    <cooldownTicks>120</cooldownTicks>
    <!-- Movement during a cast's channel phase, as a fraction of normal speed. Windup is never
         slowed and recovery roots the caster, so this is the only movement number of the system. -->
    <channelMoveSpeedFactor>0.55</channelMoveSpeedFactor>
    <!-- Upper bound on darts or orbs after Split. -->
    <maxMissiles>5</maxMissiles>
  </WhisperOfTheForest.Spells.SpellTuningDef>

  <!-- ============================================================ Carrier ability -->

  <!--
    Puts the book button and the cast button into the pawn's native gizmo row. Granted by
    SpellService to player-controlled spawned pawns with psylink level 1 or higher; the ability
    itself draws the gizmos, so no Harmony patch touches the pawn gizmo enumerators.
    Cooldown is owned by GameComponent_Spellbook, so this Def carries zero cooldown.
  -->
  <AbilityDef>
    <defName>WotF_SpellbookCast</defName>
    <label>spellbook</label>
    <description>An arcane book of arranged glyphs. Open it to choose, name and save one of ten spells, then cast the selected spell on an adjacent target, as a homing dart, or on the caster.</description>
    <abilityClass>WhisperOfTheForest.Spells.SpellAbility</abilityClass>
    <iconPath>UI/TechLabIcon</iconPath>
    <level>1</level>
    <hotKey>Misc12</hotKey>
    <hostile>false</hostile>
    <aiCanUse>false</aiCanUse>
    <showOnCharacterCard>false</showOnCharacterCard>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <showCastingProgressBar>false</showCastingProgressBar>
    <cooldownTicksRange>0~0</cooldownTicksRange>
    <statBases>
      <Ability_EntropyGain>0</Ability_EntropyGain>
      <Ability_PsyfocusCost>0</Ability_PsyfocusCost>
    </statBases>
    <verbProperties>
      <!--
        A real, instantiable verb class. Verse.VerbProperties.verbClass defaults to the abstract
        Verse.Verb, so an AbilityDef that declares verbProperties without an override makes
        VerbTracker log "Could not instantiate Verb ... Cannot create an abstract class" and leaves
        ability.verb null, which then NullReferenceExceptions in Ability.WarmupTick every tick.
        Verb_CastAbility is the vanilla concrete verb abilities use; it only satisfies Ability's
        verb machinery here (SpellAbility draws its own gizmos and SpellService does the casting),
        so no player action can reach the vanilla warmup/activate path.
      -->
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0</warmupTime>
      <range>24.9</range>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetPlants>true</canTargetPlants>
        <canTargetLocations>true</canTargetLocations>
        <canTargetSelf>false</canTargetSelf>
        <neverTargetIncapacitated>false</neverTargetIncapacitated>
      </targetParams>
    </verbProperties>
  </AbilityDef>
</Defs>
