<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Force damage used by arcane missiles when the impact mode is Damage or Explode. -->
  <DamageDef ParentName="Bullet">
    <defName>WotF_ArcaneMissileDamage</defName>
    <label>arcane force</label>
    <description>Concussive magical force that crushes rather than cuts.</description>
    <deathMessage>{0} was blasted apart by arcane force.</deathMessage>
    <hediff>Bruise</hediff>
    <hediffSolid>Crack</hediffSolid>
    <armorCategory>Blunt</armorCategory>
    <makesAnimalsFlee>false</makesAnimalsFlee>
    <soundExplosion>Explosion_Bomb</soundExplosion>
  </DamageDef>

  <!--
    Native carrier for every arcane missile (Phase 5 migration). Each missile is a real spawned
    Verse.Projectile thing, so the game owns spawn registration, ticking (TickInterval with the
    vanilla 1-visible/15-offscreen update rate), saving and destruction. The mod only supplies
    the homing step and the hit payload; drawing is owned by the selected visual backend, so the
    thing itself is never drawn (drawerType None). The projectile block exists so the def is a
    valid BaseBullet child and any vanilla read of def.projectile stays sane; the vanilla
    straight-line flight and lifetime fields are not used by Projectile_ArcaneMissiles.
  -->
  <ThingDef ParentName="BaseBullet">
    <defName>WotF_ArcaneMissileProjectile</defName>
    <label>arcane missile</label>
    <thingClass>WhisperOfTheForest.Experimental.Missiles.Projectile_ArcaneMissiles</thingClass>
    <drawerType>None</drawerType>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <texPath>Experiments/Missiles/ArcaneMissiles</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <projectile>
      <damageDef>WotF_ArcaneMissileDamage</damageDef>
      <damageAmountBase>7</damageAmountBase>
      <stoppingPower>0</stoppingPower>
      <speed>13</speed>
    </projectile>
  </ThingDef>

  <!-- Visual backends selectable by ArcaneMissileSettings.visualDef (Def + lifecycle class).
       Mod-defined Def subclasses must use their fully qualified type name as the XML root tag;
       the short name is only resolvable for Verse/RimWorld types. -->
  <WhisperOfTheForest.Experimental.Missiles.ArcaneMissileVisualDef>
    <defName>WotF_Visual_RimUnity</defName>
    <label>arcane missiles (RimUnity particles)</label>
    <visualClass>WhisperOfTheForest.Experimental.Missiles.ArcaneMissileVisualRimUnity</visualClass>
  </WhisperOfTheForest.Experimental.Missiles.ArcaneMissileVisualDef>

  <WhisperOfTheForest.Experimental.Missiles.ArcaneMissileVisualDef>
    <defName>WotF_Visual_Native</defName>
    <label>arcane missiles (native flecks)</label>
    <visualClass>WhisperOfTheForest.Experimental.Missiles.ArcaneMissileVisualNative</visualClass>
  </WhisperOfTheForest.Experimental.Missiles.ArcaneMissileVisualDef>

  <!-- Hit strategies selectable by ArcaneMissileSettings.impactDef (Def + stateless worker). -->
  <WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactDef>
    <defName>WotF_Impact_Damage</defName>
    <label>arcane impact: damage</label>
    <workerClass>WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactWorker_Damage</workerClass>
  </WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactDef>

  <WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactDef>
    <defName>WotF_Impact_Heal</defName>
    <label>arcane impact: heal</label>
    <workerClass>WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactWorker_Heal</workerClass>
  </WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactDef>

  <WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactDef>
    <defName>WotF_Impact_Explode</defName>
    <label>arcane impact: explode</label>
    <workerClass>WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactWorker_Explode</workerClass>
  </WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactDef>

  <!--
    Real Royalty psycast: abilityClass stays RimWorld.Psycast (inherited from PsycastBase), so the
    gizmo, warmup, line of sight, psyfocus and neural heat all come from vanilla. The custom comp
    only converts the resolved target into a missile volley.

    Every number below is a default; Code/XML callers can pass another ArcaneMissileSettings to
    ArcaneMissileLauncher.Fire without touching this Def.
  -->
  <AbilityDef ParentName="PsycastBase" MayRequire="Ludeon.RimWorld.Royalty">
    <defName>WotF_ArcaneMissiles</defName>
    <label>arcane missiles</label>
    <description>A volley of homing darts of raw arcane force. Each dart steers toward the chosen target - a creature, a building or a spot on the ground - and detonates on the first thing it touches. Darts turn at a limited rate, so fast or circling targets can dodge them.</description>
    <level>1</level>
    <iconPath>Experiments/Missiles/ArcaneMissiles</iconPath>
    <hotKey>Misc11</hotKey>
    <hostile>true</hostile>
    <!-- Vanilla draws this bar over the target; disable it so no bar appears. -->
    <showCastingProgressBar>true</showCastingProgressBar>
    <showPsycastEffects>true</showPsycastEffects>
    <aiCanUse>false</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <cooldownTicksRange>90~120</cooldownTicksRange>
    <statBases>
      <!-- Zero costs keep a lab pawn able to repeat casts; raise them for normal play. -->
      <Ability_EntropyGain>0</Ability_EntropyGain>
      <Ability_PsyfocusCost>0</Ability_PsyfocusCost>
    </statBases>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetLocations>true</canTargetLocations>
        <canTargetSelf>false</canTargetSelf>
        <neverTargetIncapacitated>false</neverTargetIncapacitated>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="WhisperOfTheForest.Experimental.Missiles.CompProperties_AbilityWotFArcaneMissiles">
        <settings>
          <missileCount>3</missileCount>
          <speedCellsPerSecond>13</speedCellsPerSecond>
          <maxTurnDegreesPerSecond>300</maxTurnDegreesPerSecond>
          <wobbleAmplitude>0.14</wobbleAmplitude>
          <wobbleFrequency>2.2</wobbleFrequency>
          <launchSpreadDegrees>8</launchSpreadDegrees>
          <flightHeight>1.2</flightHeight>
          <hitRadius>0.45</hitRadius>
          <lifetimeSeconds>10</lifetimeSeconds>
          <maxRangeCells>34</maxRangeCells>
          <damageAmount>7</damageAmount>
          <armorPenetration>0.5</armorPenetration>
          <damageDef>WotF_ArcaneMissileDamage</damageDef>
          <impactMode>Damage</impactMode>
          <!-- Explicit selection wins; impactMode above is only the fallback when impactDef is null. -->
          <impactDef>WotF_Impact_Damage</impactDef>
          <visualDef>WotF_Visual_RimUnity</visualDef>
          <explosionRadius>1.7</explosionRadius>
          <healAmount>10</healAmount>
          <missileSize>0.55</missileSize>
          <trailTime>0.35</trailTime>
          <missileColorHex>#9BD8FF</missileColorHex>
          <trailColorHex>#3F7DFF</trailColorHex>
        </settings>
      </li>
    </comps>
  </AbilityDef>

  <!--
    A: single heavy shell, low turn rate, explodes on the first thing it touches.
    ignoreFlightLimits=true so only a real map exit or a collision ends it; the numeric
    lifetime/range values stay at their defaults and old settings keep using them.
  -->
  <AbilityDef ParentName="PsycastBase" MayRequire="Ludeon.RimWorld.Royalty">
    <defName>WotF_ArcaneMissiles_Heavy</defName>
    <label>arcane heavy missile</label>
    <description>A single shell of arcane force that turns slowly toward its target. It explodes on impact and can be evaded by moving sideways. If it misses, it keeps flying until it leaves the map.</description>
    <level>1</level>
    <iconPath>Experiments/Missiles/ArcaneMissiles</iconPath>
    <hostile>true</hostile>
    <!-- Vanilla draws this bar over the target; disable it so no bar appears. -->
    <showCastingProgressBar>true</showCastingProgressBar>
    <showPsycastEffects>true</showPsycastEffects>
    <aiCanUse>false</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <cooldownTicksRange>90~120</cooldownTicksRange>
    <statBases>
      <Ability_EntropyGain>0</Ability_EntropyGain>
      <Ability_PsyfocusCost>0</Ability_PsyfocusCost>
    </statBases>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetLocations>true</canTargetLocations>
        <canTargetSelf>false</canTargetSelf>
        <neverTargetIncapacitated>false</neverTargetIncapacitated>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="WhisperOfTheForest.Experimental.Missiles.CompProperties_AbilityWotFArcaneMissiles">
        <settings>
          <missileCount>1</missileCount>
          <launchSpreadDegrees>0</launchSpreadDegrees>
          <speedCellsPerSecond>13</speedCellsPerSecond>
          <maxTurnDegreesPerSecond>10</maxTurnDegreesPerSecond>
          <impactMode>Explode</impactMode>
          <impactDef>WotF_Impact_Explode</impactDef>
          <visualDef>WotF_Visual_RimUnity</visualDef>
          <ignoreFlightLimits>true</ignoreFlightLimits>
          <expireOnTargetLost>false</expireOnTargetLost>
        </settings>
      </li>
    </comps>
  </AbilityDef>

  <!--
    B: single slow healer that follows one pawn/animal until it is healed once, the target is lost,
    or the missile leaves the map. Friendly ability, so hostile=false and no violence requirement.
  -->
  <AbilityDef ParentName="PsycastBase" MayRequire="Ludeon.RimWorld.Royalty">
    <defName>WotF_ArcaneMissiles_Mender</defName>
    <label>arcane mending missile</label>
    <description>A single slow, highly agile mote of restorative force. It locks onto one pawn or animal and follows it until it touches the target, healing a small amount once. If the target dies, leaves the map or is otherwise lost, the mote fades without healing anything. It moves slower than a running person.</description>
    <level>1</level>
    <iconPath>Experiments/Missiles/ArcaneMissiles</iconPath>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <!-- Vanilla draws this bar over the target; disable it so no bar appears. -->
    <showCastingProgressBar>true</showCastingProgressBar>
    <showPsycastEffects>true</showPsycastEffects>
    <aiCanUse>false</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <cooldownTicksRange>90~120</cooldownTicksRange>
    <statBases>
      <Ability_EntropyGain>0</Ability_EntropyGain>
      <Ability_PsyfocusCost>0</Ability_PsyfocusCost>
    </statBases>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <targetParams>
        <thingCategory>None</thingCategory>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetHumans>true</canTargetHumans>
        <canTargetSelf>true</canTargetSelf>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>false</canTargetLocations>
        <canTargetMechs>false</canTargetMechs>
        <canTargetItems>false</canTargetItems>
        <canTargetPlants>false</canTargetPlants>
        <canTargetFires>false</canTargetFires>
        <canTargetCorpses>false</canTargetCorpses>
        <canTargetEntities>false</canTargetEntities>
        <canTargetSubhumans>false</canTargetSubhumans>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="WhisperOfTheForest.Experimental.Missiles.CompProperties_AbilityWotFArcaneMissiles">
        <settings>
          <missileCount>1</missileCount>
          <launchSpreadDegrees>0</launchSpreadDegrees>
          <speedCellsPerSecond>4</speedCellsPerSecond>
          <maxTurnDegreesPerSecond>720</maxTurnDegreesPerSecond>
          <impactMode>Heal</impactMode>
          <impactDef>WotF_Impact_Heal</impactDef>
          <visualDef>WotF_Visual_RimUnity</visualDef>
          <ignoreFlightLimits>true</ignoreFlightLimits>
          <expireOnTargetLost>true</expireOnTargetLost>
        </settings>
      </li>
    </comps>
  </AbilityDef>

</Defs>
