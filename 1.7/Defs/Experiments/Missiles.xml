<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Force damage used by arcane missiles when the impact mode is Damage or Explode. -->
  <DamageDef ParentName="Bullet">
    <defName>WotF_ArcaneMissileDamage</defName>
    <label>arcane force</label>
    <description>Concussive magical force that crushes rather than cuts.</description>
    <deathMessage>{0} was blasted apart by arcane force.</deathMessage>
    <hediff>Bruise</hediff>
    <hediffSolid>Crack</hediffSolid>
    <armorCategory>Blunt</armorCategory>
    <makesAnimalsFlee>false</makesAnimalsFlee>
    <soundExplosion>Explosion_Bomb</soundExplosion>
  </DamageDef>

  <!--
    Native carrier for every arcane missile (Phase 5 migration). Each missile is a real spawned
    Verse.Projectile thing, so the game owns spawn registration, ticking (TickInterval with the
    vanilla 1-visible/15-offscreen update rate), saving and destruction. The mod only supplies
    the homing step and the hit payload; drawing is owned by the selected visual backend, so the
    thing itself is never drawn (drawerType None). The projectile block exists so the def is a
    valid BaseBullet child and any vanilla read of def.projectile stays sane; the vanilla
    straight-line flight and lifetime fields are not used by Projectile_ArcaneMissiles.
  -->
  <ThingDef ParentName="BaseBullet">
    <defName>WotF_ArcaneMissileProjectile</defName>
    <label>arcane missile</label>
    <thingClass>WhisperOfTheForest.Experimental.Missiles.Projectile_ArcaneMissiles</thingClass>
    <drawerType>None</drawerType>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <texPath>Experiments/Missiles/ArcaneMissiles</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <projectile>
      <damageDef>WotF_ArcaneMissileDamage</damageDef>
      <damageAmountBase>7</damageAmountBase>
      <stoppingPower>0</stoppingPower>
      <speed>13</speed>
    </projectile>
  </ThingDef>

  <!-- Visual effects of the arcane missiles: Vfx Defs like the railgun's, not a second visual system.
       A trail Def names the backend worker and the impact Def it hands over to; the impact Def names
       only its worker. The Vfx layer owns both lifetimes. Def names are unchanged, so saved volleys
       keep pointing at a def that still exists.
       Mod-defined Def subclasses must use their fully qualified type name as the XML root tag; the
       short name is only resolvable for Verse/RimWorld types. -->
  <WhisperOfTheForest.Experimental.Missiles.ArcaneMissileVisualDef>
    <defName>WotF_Visual_RimUnity</defName>
    <label>arcane missiles (RimUnity particles)</label>
    <workerClass>WhisperOfTheForest.Experimental.Missiles.ArcaneMissileRimUnityVfxWorker</workerClass>
    <lifetime>FollowThing</lifetime>
    <impactVisualDefName>WotF_Vfx_MissileImpact_RimUnity</impactVisualDefName>
  </WhisperOfTheForest.Experimental.Missiles.ArcaneMissileVisualDef>

  <WhisperOfTheForest.Experimental.Missiles.ArcaneMissileVisualDef>
    <defName>WotF_Visual_Native</defName>
    <label>arcane missiles (native flecks)</label>
    <workerClass>WhisperOfTheForest.Experimental.Missiles.ArcaneMissileNativeVfxWorker</workerClass>
    <lifetime>FollowThing</lifetime>
    <impactVisualDefName>WotF_Vfx_MissileImpact_Native</impactVisualDefName>
  </WhisperOfTheForest.Experimental.Missiles.ArcaneMissileVisualDef>

  <WhisperOfTheForest.Experimental.Vfx.VfxDef>
    <defName>WotF_Vfx_MissileImpact_RimUnity</defName>
    <label>arcane missile impact (RimUnity particles)</label>
    <workerClass>WhisperOfTheForest.Experimental.Missiles.ArcaneMissileRimUnityImpactVfxWorker</workerClass>
  </WhisperOfTheForest.Experimental.Vfx.VfxDef>

  <WhisperOfTheForest.Experimental.Vfx.VfxDef>
    <defName>WotF_Vfx_MissileImpact_Native</defName>
    <label>arcane missile impact (native flecks)</label>
    <workerClass>WhisperOfTheForest.Experimental.Missiles.ArcaneMissileNativeImpactVfxWorker</workerClass>
  </WhisperOfTheForest.Experimental.Vfx.VfxDef>

  <!-- Hit strategies selectable by ArcaneMissileSettings.impactDef (Def + stateless worker). -->
  <WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactDef>
    <defName>WotF_Impact_Damage</defName>
    <label>arcane impact: damage</label>
    <workerClass>WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactWorker_Damage</workerClass>
  </WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactDef>

  <WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactDef>
    <defName>WotF_Impact_Heal</defName>
    <label>arcane impact: heal</label>
    <workerClass>WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactWorker_Heal</workerClass>
  </WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactDef>

  <WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactDef>
    <defName>WotF_Impact_Explode</defName>
    <label>arcane impact: explode</label>
    <workerClass>WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactWorker_Explode</workerClass>
  </WhisperOfTheForest.Experimental.Missiles.ArcaneMissileImpactDef>

</Defs>
