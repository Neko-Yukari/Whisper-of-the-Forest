<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Runtime objects the new spell effects need.

    Two kinds of Def live here:
      * HediffDefs - the lasting states (clotting boost, freeze, ensnare, hex, lightning charge,
        sustained arcane wound, scorch). All tunable numbers are here; the spell only chooses how
        long each one lasts, through the Disappears comp.
      * ThingDefs - the temporary map objects: the magelight, the Linger/Rune field and the orbit orb.
        They are Ethereal (no hit points, no drawing) and own their own save data in C#.

    Nothing here is referenced by name in code as a hard-coded path except through
    SpellEffectDefs, which keeps the names in one place.
  -->

  <!-- ============================================================ Lasting states -->

  <HediffDef>
    <defName>WotF_Hediff_Clotting</defName>
    <label>clotted wounds</label>
    <description>Wounds have been bandaged by magic and are closing faster than they otherwise would.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500~2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <InjuryHealingFactor>2</InjuryHealingFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>WotF_Hediff_Freeze</defName>
    <label>frozen</label>
    <description>Rime on the joints: movement is capped while the cold lasts.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300~300</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.4</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>WotF_Hediff_Ensnare</defName>
    <label>rooted</label>
    <description>Held in place by the spell. Movement is zero; attacking is untouched, so this is not a stun.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300~300</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>WotF_Hediff_Hex</defName>
    <label>hexed</label>
    <description>A mark that makes the body take more damage and mend more slowly.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>1.25</IncomingDamageFactor>
          <InjuryHealingFactor>0.5</InjuryHealingFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>WotF_Hediff_LightningCharge</defName>
    <label>charged</label>
    <description>Residual charge from a lightning strike. The next strike hurts more for every stack already carried.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>5</maxSeverity>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- Sustained arcane wound: damage type, per-pulse amount and interval are written by the spell. -->
  <HediffDef>
    <defName>WotF_Hediff_ArcaneDot</defName>
    <label>sustained arcane wound</label>
    <description>Arcane force keeps working through the wound instead of passing in one blow.</description>
    <hediffClass>WhisperOfTheForest.Experimental.Spells.Hediff_SpellDot</hediffClass>
    <isBad>true</isBad>
    <duplicationAllowed>false</duplicationAllowed>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- The non-spreading burn behind the Sensitive variant of Ignite. -->
  <HediffDef>
    <defName>WotF_Hediff_Scorch</defName>
    <label>scorched</label>
    <description>A controlled burn that keeps searing the target without ever becoming a free-spreading fire.</description>
    <hediffClass>WhisperOfTheForest.Experimental.Spells.Hediff_SpellDot</hediffClass>
    <isBad>true</isBad>
    <duplicationAllowed>false</duplicationAllowed>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- ============================================================ Temporary map objects -->

  <!-- Light placed by Magelight. Radius, colour and age are overwritten per cast from the step;
       lifespanTicks is only the ceiling this Def allows. -->
  <ThingDef ParentName="EtherealThingBase">
    <defName>WotF_Magelight</defName>
    <label>magelight</label>
    <thingClass>ThingWithComps</thingClass>
    <tickerType>Normal</tickerType>
    <selectable>false</selectable>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>8</glowRadius>
        <glowColor>(255,233,160,0)</glowColor>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>60000</lifespanTicks>
      </li>
    </comps>
  </ThingDef>

  <!-- Linger field and Rune seal share one ThingDef: the mode, payload and timing are instance data. -->
  <ThingDef ParentName="EtherealThingBase">
    <defName>WotF_SpellField</defName>
    <label>spell field</label>
    <thingClass>WhisperOfTheForest.Experimental.Spells.Thing_SpellField</thingClass>
    <tickerType>Normal</tickerType>
    <selectable>false</selectable>
  </ThingDef>

  <!-- One orb of the Orbit form. Position follows the caster every tick. -->
  <ThingDef ParentName="EtherealThingBase">
    <defName>WotF_SpellOrbit</defName>
    <label>arcane orb</label>
    <thingClass>WhisperOfTheForest.Experimental.Spells.Thing_SpellOrbit</thingClass>
    <tickerType>Normal</tickerType>
    <selectable>false</selectable>
  </ThingDef>

</Defs>
