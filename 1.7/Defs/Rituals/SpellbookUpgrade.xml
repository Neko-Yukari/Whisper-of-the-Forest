<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 升阶仪式：消耗 1 本低阶旧书 + 升阶材料，产出 1 本高阶书（技术/02 施法硬件：三阶分档）。
       设定只写了「学徒书 + 精灵钢 + 翡翠」「织法书 + 秘银 + 星辉粉笔」，没有给数量、魔源与工作量，
       所以材料数量、manaCost、workAmount 都是占位值；圈尺寸与颜色按同阶仪式的骨架。
       旧书从祭坛周围的地面取用：佩戴中的书不算，需要先脱下丢到地上。 -->
  <WhisperOfTheForest.Rituals.RitualDef ParentName="WotF_WorkRitualBase">
    <defName>WotF_Ritual_SpellbookUpgradeAdept</defName>
    <tier>2</tier>
    <family>Crafting</family>
    <label>rite of the woven spellbook</label>
    <description>Takes one apprentice spellbook, 12 elven steel and 15 jade from the ground around the altar when the chant completes. A 5×5 green crafting circle produces one adept spellbook on completion. Spells remain with their pawn; wearing the new book opens seven slots without erasing stored recipes.</description>
    <ringSize>5</ringSize>
    <chalkColor>Green</chalkColor>
    <manaCost>150</manaCost>
    <workAmount>900</workAmount>
    <effectRadius>12.9</effectRadius>
    <!-- 占位：设定未给升阶材料数量、魔源与工作量。 -->
    <inputCosts>
      <WotF_Spellbook_Apprentice>1</WotF_Spellbook_Apprentice>
      <WotF_ElvenSteel>12</WotF_ElvenSteel>
      <Jade>15</Jade>
    </inputCosts>
    <outputProducts>
      <WotF_Spellbook_Adept>1</WotF_Spellbook_Adept>
    </outputProducts>
    <effectWorkerClass>WhisperOfTheForest.Rituals.RitualEffect_SpellbookUpgrade</effectWorkerClass>
    <researchPrerequisite>WotF_Research_Ritual_SpellbookUpgradeAdept</researchPrerequisite>
  </WhisperOfTheForest.Rituals.RitualDef>

  <WhisperOfTheForest.Rituals.RitualDef ParentName="WotF_WorkRitualBase">
    <defName>WotF_Ritual_SpellbookUpgradeArchmage</defName>
    <tier>3</tier>
    <family>Crafting</family>
    <label>rite of the starlight codex</label>
    <description>Takes one adept spellbook, 12 mithril and 10 star chalk from the ground around the altar when the chant completes. A 7×7 star crafting circle produces one starlight codex on completion. Spells remain with their pawn; the codex opens all ten slots and permits super runes.</description>
    <ringSize>7</ringSize>
    <chalkColor>Star</chalkColor>
    <manaCost>300</manaCost>
    <workAmount>1500</workAmount>
    <effectRadius>12.9</effectRadius>
    <!-- 占位：设定未给升阶材料数量、魔源与工作量。 -->
    <inputCosts>
      <WotF_Spellbook_Adept>1</WotF_Spellbook_Adept>
      <WotF_Mithril>12</WotF_Mithril>
      <WotF_ChalkStar>10</WotF_ChalkStar>
    </inputCosts>
    <outputProducts>
      <WotF_Spellbook_Archmage>1</WotF_Spellbook_Archmage>
    </outputProducts>
    <effectWorkerClass>WhisperOfTheForest.Rituals.RitualEffect_SpellbookUpgrade</effectWorkerClass>
    <researchPrerequisite>WotF_Research_Ritual_SpellbookUpgradeArchmage</researchPrerequisite>
  </WhisperOfTheForest.Rituals.RitualDef>
</Defs>
