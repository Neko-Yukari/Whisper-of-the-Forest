<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WhisperOfTheForest.Rituals.RitualDef ParentName="WotF_WorkRitualBase">
    <defName>WotF_Ritual_BottleMana</defName>
    <tier>1</tier>
    <family>Crafting</family>
    <label>rite of bottling</label>
    <description>The caster traces a white chalk ring and draws mana from the network into a vial of wood and herbs. The vial holds less than the rite spends, so bottling stores power for later rather than creating it.</description>
    <ringSize>3</ringSize>
    <chalkColor>White</chalkColor>
    <manaCost>60</manaCost>
    <workAmount>300</workAmount>
    <effectRadius>12.9</effectRadius>
    <inputCosts>
      <WoodLog>5</WoodLog>
      <MedicineHerbal>3</MedicineHerbal>
    </inputCosts>
    <outputProducts>
      <WotF_ManaVial>1</WotF_ManaVial>
    </outputProducts>
    <effectWorkerClass>WhisperOfTheForest.Rituals.RitualEffect_Transmute</effectWorkerClass>
    <researchPrerequisite>WotF_Research_Ritual_BottleMana</researchPrerequisite>
  </WhisperOfTheForest.Rituals.RitualDef>
</Defs>
