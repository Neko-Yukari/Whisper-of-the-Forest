<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <WhisperOfTheForest.Rituals.RitualDef Name="WotF_WorkRitualBase" Abstract="True">
    <strengthSpeedFactor>
      <points>
        <li>(1,1)</li>
        <li>(10,1.8)</li>
        <li>(25,2.5)</li>
        <li>(60,3.2)</li>
        <li>(100,3.5)</li>
      </points>
    </strengthSpeedFactor>
  </WhisperOfTheForest.Rituals.RitualDef>

  <!-- Ritual definitions. The altar is a mana-network consumer: it pays the cost into the network
       before the caster starts, and the effect runs once when the performance ends. -->
  <WhisperOfTheForest.Rituals.RitualDef>
    <defName>WotF_Ritual_ManaSpring</defName>
    <tier>1</tier>
    <family>Life</family>
    <label>rite of the mana spring</label>
    <description>The caster traces a white chalk ring around the altar and calls the forest's reserve back into the blood. Every bloodline member near the altar recovers mana.</description>
    <ringSize>3</ringSize>
    <chalkColor>White</chalkColor>
    <manaCost>60</manaCost>
    <durationTicks>600</durationTicks>
    <effectRadius>12.9</effectRadius>
    <!-- 占位：0..100 仪式强度，回魔量 1..3 倍；曲线端点外不再增长。 -->
    <strengthEffectFactor><points><li>(0,1)</li><li>(25,1.8)</li><li>(60,2.5)</li><li>(100,3)</li></points></strengthEffectFactor>
    <manaRestore>40</manaRestore>
    <effectWorkerClass>WhisperOfTheForest.Rituals.RitualEffect_ManaSpring</effectWorkerClass>
  </WhisperOfTheForest.Rituals.RitualDef>

  <WhisperOfTheForest.Rituals.RitualDef>
    <defName>WotF_Ritual_HealingMinor</defName>
    <tier>1</tier>
    <family>Life</family>
    <label>rite of mending</label>
    <description>The caster traces a white chalk ring around the altar and closes the ordinary wounds of everyone nearby. Fresh injuries and blood loss are healed; old scars are not.</description>
    <ringSize>3</ringSize>
    <chalkColor>White</chalkColor>
    <manaCost>50</manaCost>
    <durationTicks>600</durationTicks>
    <effectRadius>12.9</effectRadius>
    <effectWorkerClass>WhisperOfTheForest.Rituals.RitualEffect_Healing</effectWorkerClass>
  </WhisperOfTheForest.Rituals.RitualDef>

  <WhisperOfTheForest.Rituals.RitualDef>
    <defName>WotF_Ritual_HealingMedium</defName>
    <tier>2</tier>
    <family>Life</family>
    <label>rite of mending (green ring)</label>
    <description>The caster traces a green chalk ring around the altar. Everyone nearby is healed of fresh and old injuries, and lost limbs grow back. Organs are left to the greater rite.</description>
    <ringSize>5</ringSize>
    <chalkColor>Green</chalkColor>
    <manaCost>120</manaCost>
    <durationTicks>900</durationTicks>
    <effectRadius>12.9</effectRadius>
    <effectWorkerClass>WhisperOfTheForest.Rituals.RitualEffect_Healing</effectWorkerClass>
  </WhisperOfTheForest.Rituals.RitualDef>

  <WhisperOfTheForest.Rituals.RitualDef>
    <defName>WotF_Ritual_HealingGrand</defName>
    <tier>3</tier>
    <family>Life</family>
    <label>rite of mending (star ring)</label>
    <description>The caster traces a silver star-chalk ring around the altar. Everyone nearby is restored whole: wounds, scars, lost limbs and lost organs. Addictions and other curable lasting conditions are lifted, including some no healer mech serum can cure. Psychic entropy, anesthetic and artificial parts remain.</description>
    <ringSize>7</ringSize>
    <chalkColor>Star</chalkColor>
    <manaCost>300</manaCost>
    <durationTicks>1500</durationTicks>
    <effectRadius>12.9</effectRadius>
    <minParticipants>1</minParticipants>
    <effectWorkerClass>WhisperOfTheForest.Rituals.RitualEffect_Healing</effectWorkerClass>
  </WhisperOfTheForest.Rituals.RitualDef>

  <WhisperOfTheForest.Rituals.RitualDef>
    <defName>WotF_Ritual_FertileSoil</defName>
    <tier>2</tier>
    <family>Life</family>
    <label>rite of fertile awakening</label>
    <description>The caster traces a green chalk ring around the altar and wakes the soil beneath it. Natural soil within the rite's radius is raised to rich soil, with greater ritual strength widening its reach; floors, rock, buildings and growing plants are left untouched.</description>
    <ringSize>5</ringSize>
    <chalkColor>Green</chalkColor>
    <manaCost>100</manaCost>
    <durationTicks>900</durationTicks>
    <effectRadius>12.9</effectRadius>
    <!-- 占位：0..100 仪式强度将沃土覆盖半径从 1 倍放大至 2 倍。 -->
    <strengthRadiusFactor><points><li>(0,1)</li><li>(25,1.45)</li><li>(60,1.8)</li><li>(100,2)</li></points></strengthRadiusFactor>
    <effectWorkerClass>WhisperOfTheForest.Rituals.RitualEffect_FertileSoil</effectWorkerClass>
  </WhisperOfTheForest.Rituals.RitualDef>

  <WhisperOfTheForest.Rituals.RitualDef ParentName="WotF_WorkRitualBase">
    <defName>WotF_Ritual_SpellbookAwakening</defName>
    <tier>1</tier>
    <family>Crafting</family>
    <label>rite of spellbook awakening</label>
    <description>The caster traces a white chalk ring around the altar and calls a dormant spellbook out of the old world's remnants. One basic spellbook is left beside the altar for any forest-blooded pawn to wear.</description>
    <ringSize>3</ringSize>
    <chalkColor>White</chalkColor>
    <manaCost>150</manaCost>
    <workAmount>900</workAmount>
    <effectRadius>12.9</effectRadius>
    <effectWorkerClass>WhisperOfTheForest.Rituals.RitualEffect_SpellbookAwakening</effectWorkerClass>
  </WhisperOfTheForest.Rituals.RitualDef>

  <WhisperOfTheForest.Rituals.RitualDef ParentName="WotF_WorkRitualBase">
    <defName>WotF_Ritual_RuneAwakening</defName>
    <tier>1</tier>
    <family>Crafting</family>
    <label>rite of rune awakening</label>
    <description>Opens one rune for the colony using the altar tier, chalk circle, mana and work required by that rune's tier. Its offerings are locked when the rite starts and taken only when the chant completes. Super runes require rubbings.</description>
    <runeTiers>
      <li><tier>1</tier><ringSize>3</ringSize><chalkColor>White</chalkColor><manaCost>80</manaCost><workAmount>600</workAmount></li>
      <!-- 占位：T2、T3启封魔源与工作量沿用T1的80魔源、600工作量。 -->
      <li><tier>2</tier><ringSize>5</ringSize><chalkColor>Green</chalkColor><manaCost>80</manaCost><workAmount>600</workAmount></li>
      <li><tier>3</tier><ringSize>7</ringSize><chalkColor>Star</chalkColor><manaCost>80</manaCost><workAmount>600</workAmount></li>
    </runeTiers>
    <effectRadius>12.9</effectRadius>
    <chooseRune>true</chooseRune>
    <effectWorkerClass>WhisperOfTheForest.Rituals.RitualEffect_UnlockRune</effectWorkerClass>
  </WhisperOfTheForest.Rituals.RitualDef>

  <WhisperOfTheForest.Rituals.RitualDef ParentName="WotF_WorkRitualBase">
    <defName>WotF_Ritual_InscribeEquipment</defName>
    <tier>1</tier>
    <family>Crafting</family>
    <label>rite of spell inscribing</label>
    <description>The caster traces a white chalk ring around the altar with a weapon or a piece of armour laid inside it, and writes one page of a spellbook into the item. The item keeps its own copy of the spell and fires it on a hit it lands, or on the wearer being hit. Only touch, self and orbit spells can be written this way.</description>
    <ringSize>3</ringSize>
    <chalkColor>White</chalkColor>
    <manaCost>100</manaCost>
    <workAmount>900</workAmount>
    <!-- 物品谈取半径 = 3×3 粉笔环（外圈 1.9 格），不沿用其他仪式的 12.9 效果半径。 -->
    <effectRadius>1.9</effectRadius>
    <chooseEquipment>true</chooseEquipment>
    <effectWorkerClass>WhisperOfTheForest.Rituals.RitualEffect_InscribeEquipment</effectWorkerClass>
  </WhisperOfTheForest.Rituals.RitualDef>

  <JobDef>
    <defName>WotF_PerformRitual</defName>
    <driverClass>WhisperOfTheForest.Rituals.JobDriver_PerformRitual</driverClass>
    <reportString>performing a ritual.</reportString>
    <playerInterruptible>true</playerInterruptible>
    <casualInterruptible>false</casualInterruptible>
    <suspendable>false</suspendable>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <ignoreFenceBlocked>true</ignoreFenceBlocked>
  </JobDef>

  <JobDef>
    <defName>WotF_AssistRitual</defName>
    <driverClass>WhisperOfTheForest.Rituals.JobDriver_AssistRitual</driverClass>
    <reportString>attending a ritual.</reportString>
    <playerInterruptible>true</playerInterruptible>
    <casualInterruptible>false</casualInterruptible>
    <suspendable>false</suspendable>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <ignoreFenceBlocked>true</ignoreFenceBlocked>
  </JobDef>

  <!-- 自动仪式的主持作为工作，与炮塔写入法术同属 BasicWorker。右键强制主持由 FloatMenuOptionProvider_HostRitual 按仪式逐项列出，这里关掉 directOrderable，免得原版优先菜单再列一项。 -->
  <WorkGiverDef>
    <defName>WotF_HostRitual</defName>
    <label>host rites at altars</label>
    <giverClass>WhisperOfTheForest.Rituals.WorkGiver_HostRitual</giverClass>
    <workType>BasicWorker</workType>
    <priorityInType>30</priorityInType>
    <directOrderable>false</directOrderable>
    <verb>host a rite at</verb>
    <gerund>hosting a rite at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- 与原版 HaulToSubcoreScanner 同档（Biotech HaulToBase：Hauling / 90）。 -->
  <WorkGiverDef>
    <defName>WotF_HaulRitualOfferings</defName>
    <label>haul offerings to ritual altars</label>
    <giverClass>WhisperOfTheForest.Rituals.WorkGiver_HaulRitualOfferings</giverClass>
    <workType>Hauling</workType>
    <priorityInType>90</priorityInType>
    <verb>haul offerings to</verb>
    <gerund>hauling offerings to</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <ThingDef Name="WotF_RitualAltarBase" ParentName="BuildingBase" Abstract="True">
    <size>(1,1)</size>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2520</uiOrder>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.35</fillPercent>
    <pathCost>20</pathCost>
    <tickerType>Rare</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <selectable>true</selectable>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <placeWorkers>
      <li>WhisperOfTheForest.Mana.PlaceWorker_ManaNetwork</li>
    </placeWorkers>
    <graphicData>
      <texPath>Buildings/RitualAltar</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>350</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>10</Beauty>
    </statBases>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities><li>WotF_RitualLivingwoodLamp</li><li>WotF_RitualElvenStatue</li></linkableFacilities>
      </li>
      <li Class="CompProperties_ProjectileInterceptor">
        <radius>12.9</radius>
        <interceptGroundProjectiles>true</interceptGroundProjectiles>
        <interceptAirProjectiles>true</interceptAirProjectiles>
        <drawWithNoSelection>true</drawWithNoSelection>
        <hitPoints>600</hitPoints>
        <startWithMaxHitPoints>true</startWithMaxHitPoints>
        <activated>true</activated>
        <activeDuration>60000</activeDuration>
        <color>(0.45,0.85,0.55,1)</color>
        <minAlpha>0.12</minAlpha>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>WotF_ChalkMark_White</defName>
    <label>white chalk mark</label>
    <description>A line of pale ritual chalk. A ring of these around an altar carries the rite.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2530</uiOrder>
    <costList>
      <WotF_Chalk>1</WotF_Chalk>
    </costList>
    <altitudeLayer>Filth</altitudeLayer>
    <!-- Standable, not PassThroughOnly: ritual participants stand on the chalk border, and a path
         destination must be Standable - the same rule vanilla applies when it picks psychic ritual
         spots (CompPsychicRitualSpot.cs:86). -->
    <passability>Standable</passability>
    <fillPercent>0.01</fillPercent>
    <pathCost>0</pathCost>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <drawerType>MapMeshOnly</drawerType>
    <graphicData>
      <texPath>Buildings/ChalkMark</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <color>(235,235,225)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>1</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isInert>true</isInert>
      <deconstructible>true</deconstructible>
    </building>
    <comps>
      <li Class="WhisperOfTheForest.Rituals.CompProperties_ChalkMark">
        <color>White</color>
      </li>
    </comps>
  </ThingDef>

