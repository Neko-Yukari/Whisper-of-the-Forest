  <ThingDef ParentName="ResourceBase">
    <defName>WotF_Chalk</defName>
    <label>ritual chalk</label>
    <description>Pale sticks of ritual chalk. Crafted from wood ash and a little steel, then drawn into rings around an altar.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <stackLimit>75</stackLimit>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <texPath>Things/Item/Chalk</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.9,0.9)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>1.2</MarketValue>
      <Mass>0.02</Mass>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>

  <RecipeDef>
    <defName>WotF_MakeChalk</defName>
    <label>make ritual chalk</label>
    <description>Craft ritual chalk from wood ash and a little steel.</description>
    <jobString>making ritual chalk.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <workAmount>600</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <products>
      <WotF_Chalk>10</WotF_Chalk>
    </products>
    <skillRequirements>
      <Crafting>2</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>CraftingSpot</li>
      <li>TableMachining</li>
    </recipeUsers>
  </RecipeDef>

</Defs>
