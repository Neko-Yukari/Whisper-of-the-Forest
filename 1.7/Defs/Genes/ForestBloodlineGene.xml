<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Forest bloodline (林庭血脉).

    HAR carries the body, the gene carries the magic: the mana bar is a Gene_Resource, and the
    caster level and experience are saved on this gene's instance. Every level number is a curve
    over the bloodline level (1..maxLevel) below; the vanilla psylink only mirrors the level.
  -->

  <WhisperOfTheForest.Race.WotF_ForestBloodlineGeneDef>
    <defName>WotF_ForestBloodline</defName>
    <label>forest bloodline</label>
    <labelShortAdj>forest-blooded</labelShortAdj>
    <description>An inherited bond with the forest's old magic. Carriers hold mana, learn their own kind of casting, and can wake a spellbook that is dead in anyone else's hands. The bond also raises how much neural heat the body can bear.</description>
    <displayCategory>Ability</displayCategory>
    <dontMindRawFood>true</dontMindRawFood>
    <biostatCpx>2</biostatCpx>
    <geneClass>WhisperOfTheForest.Race.Gene_ForestBloodline</geneClass>
    <resourceGizmoType>WhisperOfTheForest.Race.GeneGizmo_ForestMana</resourceGizmoType>
    <showGizmoOnWorldView>true</showGizmoOnWorldView>
    <showGizmoWhenDrafted>true</showGizmoWhenDrafted>
    <resourceLabel>mana</resourceLabel>
    <resourceDescription>The caster's own reserve. A spell spends it when it resolves; the maximum is set by the bloodline level and can be raised further by a spellbook or a staff.</resourceDescription>
    <manaMaxStat>WotF_ManaMax</manaMaxStat>
    <manaRegenStat>WotF_ManaRegen</manaRegenStat>
    <manaRegenCurve>
      <points>
        <li>(1, 0.55)</li>
        <li>(20, 0.85)</li>
      </points>
    </manaRegenCurve>
    <manaBarColor>(0.36, 0.62, 0.92)</manaBarColor>
    <manaBarHighlightColor>(0.62, 0.85, 1)</manaBarHighlightColor>
    <resourceGizmoThresholds />

    <maxLevel>20</maxLevel>
    <!-- Placeholders: the old six-level table's numbers, flat beyond them. -->
    <xpToNextLevelCurve>
      <points>
        <li>(1, 100)</li>
        <li>(2, 200)</li>
        <li>(3, 400)</li>
        <li>(4, 800)</li>
        <li>(5, 1600)</li>
      </points>
    </xpToNextLevelCurve>
    <manaMaxCurve>
      <points>
        <li>(1, 100)</li>
        <li>(6, 300)</li>
      </points>
    </manaMaxCurve>
    <!--
      Vanilla psylink levels 1-6 multiply the neural-heat limit (base 30) and recovery rate; a
      bloodline pawn does not get those factors. These two curves put the vanilla value of each
      mirror link on the bloodline level that unlocks it, flat after level 11.
    -->
    <entropyMaxCurve>
      <points>
        <li>(1, 0)</li>
        <li>(3, 10)</li>
        <li>(5, 20)</li>
        <li>(7, 30)</li>
        <li>(9, 40)</li>
        <li>(11, 50)</li>
      </points>
    </entropyMaxCurve>
    <entropyRecoveryFactorCurve>
      <points>
        <li>(1, 1)</li>
        <li>(3, 1.125)</li>
        <li>(5, 1.25)</li>
        <li>(7, 1.375)</li>
        <li>(9, 1.5)</li>
        <li>(11, 1.625)</li>
      </points>
    </entropyRecoveryFactorCurve>
    <!-- Entry n unlocks mirror psylink level n + 1: mirror = ceil(level / 2), capped at 6. -->
    <psylinkUnlockLevels>
      <li>1</li>
      <li>3</li>
      <li>5</li>
      <li>7</li>
      <li>9</li>
      <li>11</li>
    </psylinkUnlockLevels>
  </WhisperOfTheForest.Race.WotF_ForestBloodlineGeneDef>

</Defs>
