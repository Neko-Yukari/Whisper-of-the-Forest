<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Forest bloodline stats.

    WotF_ManaMax is the mana bar's capacity. It has no base value: the level's contribution is a
    StatPart, so a spellbook, a staff or a potion later only has to add another modifier to the same
    stat. PsychicEntropyMax is the vanilla neural-heat limit; the same level contribution is
    attached to it in C# (see StatPart_ForestBloodline) because it is a Core Def.
  -->

  <StatDef>
    <defName>WotF_ManaMax</defName>
    <label>mana capacity</label>
    <description>The maximum mana a forest bloodline caster can hold. The bloodline level sets the base amount and equipment can add to it.</description>
    <category>Basics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <hideAtValue>0</hideAtValue>
    <toStringStyle>Integer</toStringStyle>
    <showOnAnimals>false</showOnAnimals>
    <showOnMechanoids>false</showOnMechanoids>
    <showOnDrones>false</showOnDrones>
    <parts>
      <li Class="WhisperOfTheForest.Experimental.Race.StatPart_ForestBloodlineMana" />
    </parts>
  </StatDef>

</Defs>
