<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Forest bloodline stats.

    WotF_ManaMax is the mana bar's capacity. It has no base value: the level's contribution is a
    StatPart, so a spellbook, a staff or a potion later only has to add another modifier to the same
    stat. PsychicEntropyMax and PsychicEntropyRecoveryRate are the vanilla neural-heat stats; the
    level's contribution is attached to them in C# (see StatPart_ForestBloodline) because they are
    Core Defs.
  -->

  <StatDef>
    <defName>WotF_ManaMax</defName>
    <label>mana capacity</label>
    <description>The maximum mana a forest bloodline caster can hold. The bloodline level sets the base amount and equipment can add to it.</description>
    <category>Basics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <hideAtValue>0</hideAtValue>
    <toStringStyle>Integer</toStringStyle>
    <showOnAnimals>false</showOnAnimals>
    <showOnMechanoids>false</showOnMechanoids>
    <showOnDrones>false</showOnDrones>
    <parts>
      <li Class="WhisperOfTheForest.Race.StatPart_ForestBloodlineMana" />
    </parts>
  </StatDef>

  <!--
    Mana restored per second. The worker supplies the level base before equipment offsets and factors.
  -->
  <StatDef>
    <defName>WotF_ManaRegen</defName>
    <label>mana recovery</label>
    <description>How much mana a forest bloodline caster recovers per second.</description>
    <category>Basics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <hideAtValue>0</hideAtValue>
    <toStringStyle>FloatTwo</toStringStyle>
    <formatString>{0}/s</formatString>
    <workerClass>WhisperOfTheForest.Race.StatWorker_ForestBloodlineManaRegen</workerClass>
    <showOnAnimals>false</showOnAnimals>
    <showOnMechanoids>false</showOnMechanoids>
    <showOnDrones>false</showOnDrones>
  </StatDef>

</Defs>
