<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The forest bloodline ladder.

    One Def per level. The gene's levelTable lists these in order and C# reads every number from
    here: experience needed to leave the level, the level's mana cap, and the flat addition to the
    vanilla neural-heat limit. These numbers are first-pass placeholders, not a balance decision.
    A future specialisation becomes another table (or another StatPart) without touching the gene's
    saved data, which only stores level and experience.
  -->

  <WhisperOfTheForest.Experimental.Race.WotF_CasterLevelDef>
    <defName>WotF_CasterLevel_1</defName>
    <label>forest bloodline level 1</label>
    <level>1</level>
    <xpToNextLevel>100</xpToNextLevel>
    <manaMax>100</manaMax>
    <entropyMaxBonus>0</entropyMaxBonus>
  </WhisperOfTheForest.Experimental.Race.WotF_CasterLevelDef>

