<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Layer 15 world-mesh programs routed into RimLumen's HDR target (RimLumenRenderHost.LumenRenderPassId)
    and Layer 14 world-mesh program routed into RimLumen's RG16F Distortion target (RimLumenRenderHost.DistortionPassId).
    Every shader routed to Layer 14/15 must keep depthWrite=false; Layer 14 also requires depthTest=false
    because DistortionPass has no depth attachment (VkFormat.Undefined).
  -->

  <ShaderDef>
    <defName>WotF_Shader_LumenRibbonDepth</defName>
    <shaderProgram>
      <vertexShaderFileName>WotF_LumenRibbon.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>WotF_LumenRibbon.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3010</renderQueue>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>One</blendDstFactor>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>WotF_Shader_LumenRibbonOver</defName>
    <shaderProgram>
      <vertexShaderFileName>WotF_LumenRibbon.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>WotF_LumenRibbon.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3020</renderQueue>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>One</blendDstFactor>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>WotF_Shader_LumenDistortion</defName>
    <shaderProgram>
      <vertexShaderFileName>WotF_LumenDistortion.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>WotF_LumenDistortion.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3000</renderQueue>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>One</blendDstFactor>
    </shaderProgram>
  </ShaderDef>

</Defs>
