<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Spell Theme Templates (data-driven palettes + RimLumen particle rigs + charge/release audio).
    Adding a new magic type only adds a SpellThemeDef here and binds glyphs to it in Spellbook XML.
  -->

  <WhisperOfTheForest.Vfx.SpellThemeDef>
    <defName>WotF_Theme_Vitality</defName>
    <label>vitality theme</label>
    <coreColor>#E9FFF4</coreColor>
    <primaryColor>#57D993</primaryColor>
    <secondaryColor>#1D9E6C</secondaryColor>
    <lightColor>#4AE090</lightColor>
    <hdrIntensity>1.05</hdrIntensity>
    <castLumenEffectId>NekoYukari.WhisperOfTheForest:CastVortex_Vitality</castLumenEffectId>
    <quickCastLumenEffectId>NekoYukari.WhisperOfTheForest:CastQuick_Vitality</quickCastLumenEffectId>
    <castChargeSound>WotF_Sound_Cast_Vitality_Charge</castChargeSound>
    <castReleaseSound>WotF_Sound_Cast_Vitality_Release</castReleaseSound>
  </WhisperOfTheForest.Vfx.SpellThemeDef>

