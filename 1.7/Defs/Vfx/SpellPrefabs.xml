    <height>0.3</height><scale>1</scale><scaleToWidth>true</scaleToWidth>
    <particleLayers>
      <li>
        <name>Flame</name><color>0.95,0.075,0.045,0.8</color><size>(0.075,0.32,0.075)</size>
