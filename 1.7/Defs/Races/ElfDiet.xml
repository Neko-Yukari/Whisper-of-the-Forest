<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    An elf eats what a human eats plus living grasses and flowers (Elf.xml foodType OmnivoreHuman,Plant,
    narrowed by WotF_ForestPlantDiet in ForestDiet.cs to exclude trees, harvestable crops, bushes and thorns).
    Eating anything whose ingestible.foodType is Plant leaves this memory;
    Source/WhisperOfTheForest/Race/ForestDiet.cs adds it to vanilla's ingest thoughts.
    Shape copied from vanilla AteRawFood (Core/Defs/ThoughtDefs/Thoughts_Memory_Eating.xml): same class,
    bubble, icon and one-day duration, milder mood (-4 against -7).
  -->
  <WhisperOfTheForest.Race.ForestPlantDietDef>
    <defName>WotF_ForestPlantDiet</defName>
    <label>forest plant diet</label>
    <!-- Trees (plant.IsTree) and harvestable crops (plant.Harvestable) are excluded by rule;
         remaining non-grass/non-flower plants (bushes, thorns, cacti, rafflesia, giant fungi) are excluded here
         so bush-based or modded flowers like Plant_Clivia remain edible. -->
    <excludedPlantDefNames>
      <li>Plant_Bush</li>
      <li>Plant_Bush_Leafless</li>
      <li>Plant_ShrubLow</li>
      <li>Plant_Alocasia</li>
      <li>Plant_Brambles</li>
      <li>Plant_Brambles_Leafless</li>
      <li>Plant_Chokevine</li>
      <li>Plant_Ripthorn</li>
      <li>Plant_Thornvine</li>
      <li>Plant_PincushionCactus</li>
      <li>Plant_MagmaCactus</li>
      <li>Plant_Rafflesia</li>
      <li>Plant_NightRafflesia</li>
      <li>Bryolux</li>
      <li>Plant_Willowgill</li>
    </excludedPlantDefNames>
  </WhisperOfTheForest.Race.ForestPlantDietDef>

  <ThoughtDef>
    <defName>WotF_AtePlant</defName>
    <thoughtClass>Thought_FoodEaten</thoughtClass>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate wild plants</label>
        <description>I'm not a deer...</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
