<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    An elf eats what a human eats plus living plants (Elf.xml foodType OmnivoreHuman,Plant,Tree).
    Eating anything whose ingestible.foodType is Plant or Tree (grass, bushes, trees, hay) leaves this
    memory; Source/WhisperOfTheForest/Race/ForestDiet.cs adds it to vanilla's ingest thoughts.
    Shape copied from vanilla AteRawFood (Core/Defs/ThoughtDefs/Thoughts_Memory_Eating.xml): same class,
    bubble, icon and one-day duration, milder mood (-4 against -7).
  -->
  <ThoughtDef>
    <defName>WotF_AtePlant</defName>
    <thoughtClass>Thought_FoodEaten</thoughtClass>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate wild plants</label>
        <description>I'm not a deer...</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
