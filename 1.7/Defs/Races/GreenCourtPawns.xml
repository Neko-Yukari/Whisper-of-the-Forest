<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Pawn kinds for the Verdant Court faction. The race is the HAR elf; the bloodline gene
    comes from the race itself (raceGenes), so every generated member can hold mana.
  -->
  <PawnKindDef Name="WotF_ElfBase" Abstract="True">
    <race>WotF_Elf</race>
    <fixedGender>Female</fixedGender>
    <nameMakerFemale>WotF_ElfNames</nameMakerFemale>
    <defaultFactionDef>WotF_GreenCourt</defaultFactionDef>
    <maxGenerationAge>600</maxGenerationAge>
    <chemicalAddictionChance>0.02</chemicalAddictionChance>
    <invNutrition>2.55</invNutrition>
    <invFoodDef>Pemmican</invFoodDef>
    <apparelTags>
      <li>Neolithic</li>
    </apparelTags>
  </PawnKindDef>

  <PawnKindDef ParentName="WotF_ElfBase">
    <defName>WotF_Elf_Villager</defName>
    <label>forest elf</label>
    <combatPower>45</combatPower>
    <isFighter>false</isFighter>
    <itemQuality>Poor</itemQuality>
    <gearHealthRange>0.2~2.0</gearHealthRange>
    <weaponTags>
      <li>NeolithicMeleeBasic</li>
    </weaponTags>
    <weaponMoney>80~150</weaponMoney>
    <apparelMoney>150~300</apparelMoney>
    <apparelAllowHeadgearChance>0.2</apparelAllowHeadgearChance>
    <techHediffsChance>0.02</techHediffsChance>
    <initialWillRange>0~1</initialWillRange>
    <initialResistanceRange>10~17</initialResistanceRange>
  </PawnKindDef>

  <PawnKindDef ParentName="WotF_ElfBase">
    <defName>WotF_Elf_Warrior</defName>
    <label>forest warden</label>
    <combatPower>55</combatPower>
    <isFighter>true</isFighter>
    <itemQuality>Poor</itemQuality>
    <gearHealthRange>0.5~1.8</gearHealthRange>
    <weaponTags>
      <li>NeolithicMeleeDecent</li>
    </weaponTags>
    <weaponMoney>150~200</weaponMoney>
    <apparelMoney>250~400</apparelMoney>
    <requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
    <techHediffsChance>0.02</techHediffsChance>
    <initialWillRange>1~3</initialWillRange>
    <initialResistanceRange>5~9</initialResistanceRange>
  </PawnKindDef>

  <PawnKindDef ParentName="WotF_ElfBase">
    <defName>WotF_Elf_Archer</defName>
    <label>forest archer</label>
    <combatPower>50</combatPower>
    <isFighter>true</isFighter>
    <itemQuality>Poor</itemQuality>
    <gearHealthRange>0.5~1.8</gearHealthRange>
    <weaponTags>
      <li>NeolithicRangedBasic</li>
    </weaponTags>
    <weaponMoney>100~150</weaponMoney>
    <apparelMoney>200~350</apparelMoney>
    <disallowedTraits>
      <li>Brawler</li>
    </disallowedTraits>
    <requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
    <techHediffsChance>0.02</techHediffsChance>
    <initialWillRange>1~3</initialWillRange>
    <initialResistanceRange>17~27</initialResistanceRange>
  </PawnKindDef>

  <PawnKindDef ParentName="WotF_ElfBase">
    <defName>WotF_Elf_Trader</defName>
    <label>forest trader</label>
    <trader>true</trader>
    <combatPower>40</combatPower>
    <isFighter>false</isFighter>
    <itemQuality>Normal</itemQuality>
    <gearHealthRange>1~1</gearHealthRange>
    <weaponTags>
      <li>NeolithicMeleeBasic</li>
    </weaponTags>
    <weaponMoney>100~150</weaponMoney>
    <apparelMoney>300~500</apparelMoney>
    <apparelAllowHeadgearChance>0.4</apparelAllowHeadgearChance>
    <techHediffsChance>0.02</techHediffsChance>
    <initialWillRange>2~4</initialWillRange>
    <initialResistanceRange>12~20</initialResistanceRange>
  </PawnKindDef>

  <PawnKindDef ParentName="WotF_ElfBase">
    <defName>WotF_Elf_Leader</defName>
    <label>archon</label>
    <combatPower>60</combatPower>
    <isFighter>true</isFighter>
    <itemQuality>Normal</itemQuality>
    <gearHealthRange>0.6~2</gearHealthRange>
    <weaponTags>
      <li>NeolithicMeleeDecent</li>
    </weaponTags>
    <weaponMoney>150~250</weaponMoney>
    <apparelMoney>400~600</apparelMoney>
    <apparelRequired>
      <li>WotF_Spellbook_Basic</li>
    </apparelRequired>
    <requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
    <techHediffsChance>0.02</techHediffsChance>
    <initialWillRange>2~5</initialWillRange>
    <initialResistanceRange>15~24</initialResistanceRange>
  </PawnKindDef>

</Defs>
