<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The elf race. HAR owns the skeleton (body, head, hair placeholders); the forest bloodline gene
    owns the magic and is always present through raceGenes.

    Placeholder art lives in Textures/Placeholder/Milira/ (git-ignored). Its layout follows what
    HAR 1.7 generates:
      body: graphicPaths.body path prefix + "Naked_" + body type defName
      head: graphicPaths.head path prefix + the HeadTypeDef's graphicPath file name
    Body textures are copied from the Milira female body, head from MiliraHead0, hair from the
    Milira hair overlay. Nothing here refers to Milira's own Defs, only to the copied files.
  -->

  <AlienRace.ThingDef_AlienRace ParentName="BasePawn">
    <defName>WotF_Elf</defName>
    <label>elf</label>
    <description>A tall, long-lived people of the old forests. Their bodies are built for a life among trees, and their bloodline still answers to the magic that humans only reach through archotech psylinks.</description>

    <statBases>
      <MarketValue>1750</MarketValue>
      <MoveSpeed>5.0</MoveSpeed>
      <MeleeDodgeChance>8</MeleeDodgeChance>
      <ComfyTemperatureMin>16</ComfyTemperatureMin>
      <ComfyTemperatureMax>26</ComfyTemperatureMax>
      <LeatherAmount>75</LeatherAmount>
      <RoyalFavorValue>3</RoyalFavorValue>
      <Wildness>0.75</Wildness>
    </statBases>

    <!-- BasePawn carries no tools; without them Pawn_MeleeVerbs has no verb to use. -->
    <tools>
      <li>
        <label>left fist</label>
        <labelNoLocation>fist</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8.2</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>right fist</label>
        <labelNoLocation>fist</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8.2</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>teeth</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>8.2</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.07</chanceFactor>
        <soundMeleeHit>Pawn_Melee_HumanBite_Hit</soundMeleeHit>
        <soundMeleeMiss>Pawn_Melee_HumanBite_Miss</soundMeleeMiss>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>

    <race>
      <thinkTreeMain>Humanlike</thinkTreeMain>
      <thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
      <intelligence>Humanlike</intelligence>
      <makesFootprints>true</makesFootprints>
      <lifeExpectancy>500</lifeExpectancy>
      <hediffGiverSets>
        <li>OrganicStandard</li>
        <li>Human</li>
      </hediffGiverSets>
      <ageGenerationCurve>
        <points>
          <li>(0, 0)</li>
          <li>(3, 10)</li>
          <li>(13, 20)</li>
          <li>(20, 100)</li>
          <li>(300, 100)</li>
          <li>(400, 50)</li>
          <li>(500, 10)</li>
          <li>(600, 0)</li>
        </points>
      </ageGenerationCurve>
      <bloodDef>Filth_Blood</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <leatherDef>Leather_Human</leatherDef>
      <nameCategory>HumanStandard</nameCategory>
      <body>Human</body>
      <renderTree>Humanlike</renderTree>
      <baseBodySize>1</baseBodySize>
      <baseHealthScale>1</baseHealthScale>
      <foodType>VegetarianAnimal,Plant,Tree</foodType>
      <gestationPeriodDays>18</gestationPeriodDays>
      <meatMarketValue>0.8</meatMarketValue>
      <manhunterOnDamageChance>0.50</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.10</manhunterOnTameFailChance>
      <soundCallIntervalRange>2000~5000</soundCallIntervalRange>
      <canBecomeShambler>true</canBecomeShambler>
      <knowledgeCategory MayRequire="Ludeon.RimWorld.Anomaly">Basic</knowledgeCategory>
      <anomalyKnowledge>1</anomalyKnowledge>
      <hasUnnaturalCorpse>true</hasUnnaturalCorpse>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(1.01, 0.02)</li>
          <li>(3.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>HumanlikeBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>HumanlikeChild</def>
          <minAge>3</minAge>
        </li>
        <li MayRequire="Ludeon.RimWorld.Biotech">
          <def>HumanlikePreTeenager</def>
          <minAge>9</minAge>
        </li>
        <li>
          <def>HumanlikeTeenager</def>
          <minAge>13</minAge>
        </li>
        <li>
          <def>HumanlikeAdult</def>
          <minAge>20</minAge>
        </li>
      </lifeStageAges>
      <lifeStageWorkSettings MayRequire="Ludeon.RimWorld.Biotech">
        <Firefighter>7</Firefighter>
        <Patient>0</Patient>
        <Doctor>10</Doctor>
        <PatientBedRest>0</PatientBedRest>
        <Childcare MayRequire="Ludeon.RimWorld.Biotech">0</Childcare>
        <BasicWorker>3</BasicWorker>
        <Warden>10</Warden>
        <Handling>7</Handling>
        <Cooking>7</Cooking>
        <Hunting>7</Hunting>
        <Construction>10</Construction>
        <Growing>7</Growing>
        <Mining>7</Mining>
        <PlantCutting>7</PlantCutting>
        <Smithing>13</Smithing>
        <Tailoring>7</Tailoring>
        <Art>10</Art>
        <Crafting>7</Crafting>
        <Hauling>3</Hauling>
        <Cleaning>3</Cleaning>
        <Research>13</Research>
        <DarkStudy MayRequire="Ludeon.RimWorld.Anomaly">13</DarkStudy>
      </lifeStageWorkSettings>
      <soundMeleeDodge>Pawn_MeleeDodge</soundMeleeDodge>
      <specialShadowData>
        <volume>(0.3, 0.8, 0.4)</volume>
        <offset>(0,0,-0.3)</offset>
      </specialShadowData>
    </race>

    <alienRace>
      <generalSettings>
        <maleGenderProbability>0</maleGenderProbability>
        <minAgeForAdulthood>20</minAgeForAdulthood>
        <childBackstoryFilter>
          <li>
            <categories><li>GreenCourt_Childhood</li></categories>
          </li>
        </childBackstoryFilter>
        <humanRecipeImport>true</humanRecipeImport>

        <alienPartGenerator>
          <bodyTypes>
            <li>Thin</li>
            <li MayRequire="Ludeon.RimWorld.Biotech">Baby</li>
            <li MayRequire="Ludeon.RimWorld.Biotech">Child</li>
          </bodyTypes>
          <headTypes>
            <li>WotF_Head_Elf</li>
          </headTypes>
          <customDrawSize>(1,1)</customDrawSize>
          <customHeadDrawSize>(1,1)</customHeadDrawSize>
          <customPortraitDrawSize>(1,1)</customPortraitDrawSize>

          <!-- The Milira placeholder body is already painted in flesh tones; this channel only
               applies a narrow warm tint, so every elf stays within a few pale flesh shades
               instead of rolling arbitrary HAR skin colours. -->
          <colorChannels>
            <li>
              <name>skin</name>
              <first Class="ColorGenerator_Options">
                <options>
                  <li><weight>20</weight><only>RGBA(1.000, 1.000, 1.000, 1.000)</only></li>
                  <li><weight>20</weight><only>RGBA(0.992, 0.933, 0.882, 1.000)</only></li>
                  <li><weight>20</weight><only>RGBA(0.976, 0.894, 0.839, 1.000)</only></li>
                  <li><weight>20</weight><only>RGBA(0.945, 0.847, 0.780, 1.000)</only></li>
                  <li><weight>20</weight><only>RGBA(0.898, 0.784, 0.706, 1.000)</only></li>
                </options>
              </first>
              <second Class="ColorGenerator_Options">
                <options>
                  <li><weight>1</weight><only>RGBA(1.000, 1.000, 1.000, 1.000)</only></li>
                </options>
              </second>
            </li>
          </colorChannels>

          <bodyAddons>
            <!-- Placeholder hair, front layer. Layer depth copied from Milira's own addon. -->
            <li>
              <name>hair</name>
              <userCustomizable>true</userCustomizable>
              <path>Placeholder/Milira/Hair/HairMain/MiliraHair</path>
              <inFrontOfBody>true</inFrontOfBody>
              <layerInvert>false</layerInvert>
              <colorChannel>hair</colorChannel>
              <defaultOffset>Center</defaultOffset>
              <drawSize>1</drawSize>
              <alignWithHead>true</alignWithHead>
              <scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
              <conditions>
                <BodyPart>
                  <bodyPart>Head</bodyPart>
                </BodyPart>
                <Posture>
                  <drawnStanding>true</drawnStanding>
                  <drawnInBed>true</drawnInBed>
                  <drawnLaying>true</drawnLaying>
                </Posture>
              </conditions>
              <offsets>
                <west>
                  <layerOffset>-0.274</layerOffset>
                </west>
                <south>
                  <layerOffset>-0.274</layerOffset>
                </south>
                <north>
                  <layerOffset>-0.274</layerOffset>
                </north>
                <east>
                  <layerOffset>-0.274</layerOffset>
                </east>
              </offsets>
            </li>

            <!-- Placeholder hair, back layer. Variant index follows the front layer. -->
            <li>
              <name>hair background</name>
              <userCustomizable>true</userCustomizable>
              <path>Placeholder/Milira/Hair/HairBackGround/MiliraHairBG</path>
              <inFrontOfBody>false</inFrontOfBody>
              <layerInvert>false</layerInvert>
              <colorChannel>hair</colorChannel>
              <defaultOffset>Center</defaultOffset>
              <drawSize>1</drawSize>
              <alignWithHead>true</alignWithHead>
              <scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
              <linkVariantIndexWithPrevious>true</linkVariantIndexWithPrevious>
              <conditions>
                <BodyPart>
                  <bodyPart>Head</bodyPart>
                </BodyPart>
                <Posture>
                  <drawnStanding>true</drawnStanding>
                  <drawnInBed>false</drawnInBed>
                  <drawnLaying>true</drawnLaying>
                </Posture>
              </conditions>
              <offsets>
                <west>
                  <layerOffset>-0.275</layerOffset>
                </west>
                <south>
                  <layerOffset>-0.299</layerOffset>
                </south>
                <north>
                  <layerOffset>-0.275</layerOffset>
                </north>
                <east>
                  <layerOffset>-0.275</layerOffset>
                </east>
              </offsets>
            </li>
          </bodyAddons>
        </alienPartGenerator>

        <!--
          No raceGenes (route B, 技术/01-种族与派系实现.md:24). The four genes now come only from
          WotF_ElfXenotype (1.7/Defs/Genes/ElfXenotype.xml, inheritable=true).

          HAR adds raceGenes to every member of the race as endogenes before the xenotype runs
          (Source/AlienRace/AlienRace/HarmonyPatches.cs:3675-3682), regardless of which xenotype the
          pawn ends up with. Keeping them here would hand the full set to a half-elf or to any pawn
          whose xenotype was edited, and Biotech inheritance would be bypassed.
        -->
      </generalSettings>

      <graphicPaths>
        <body>
          <path>Placeholder/Milira/Bodies/</path>
        </body>
        <head>
          <path>Placeholder/Milira/Heads/</path>
        </head>
      </graphicPaths>

      <!-- The placeholder hair is a body addon; vanilla hair would draw a second layer over it.
           With hasStyle false HAR only allows HairDefs tagged alienNoStyle, which is Bald.
           Vanilla tattoos are masked to vanilla body/head shapes and draw as dark blocks over
           the Milira placeholder body, so face and body tattoos are off too (NoTattoo only). -->
      <styleSettings>
        <li>
          <key>HairDef</key>
          <value>
            <hasStyle>false</hasStyle>
          </value>
        </li>
        <li>
          <key>TattooDef</key>
          <value>
            <hasStyle>false</hasStyle>
          </value>
        </li>
      </styleSettings>

      <!-- Vanilla appearance genes would draw a second ears/tail/body/hair layer over HAR art. -->
      <raceRestriction>
        <!--
          First elven apparel batch (技术/02-魔法实现.md:141 「全部限定精灵种族穿戴」).

          HAR resolves this list in ThingDef_AlienRace.ResolveReferences: every entry is added to the
          static RaceRestrictionSettings.apparelRestricted and to this race's whiteApparelList
          (IL_07d0-IL_081c). CanWear then returns "whiteApparelList.Contains(def)" for any apparel that
          is in apparelRestricted or when onlyUseRaceRestrictedApparel is true, and ANDs that with
          "!blackApparelList.Contains(def)". So a human (no alienRace settings) fails the white-list
          test and cannot wear these, while onlyUseRaceRestrictedApparel stays false so elves remain
          free to wear every vanilla garment.
        -->
        <apparelList>
          <li>WotF_ElvenDressTraditional_I</li>
          <li>WotF_ElvenDressTraditional_II</li>
          <li>WotF_ElvenApronDress</li>
          <li>WotF_ElvenHunterUndershirt</li>
          <li>WotF_ElvenFormalGown</li>
          <li>WotF_ElvenTravelCloak</li>
          <li>WotF_TerrainStride</li>
          <li>WotF_ElvenLightArmor</li>
          <li>WotF_ElvenMageRobe</li>
          <li>WotF_ElvenWarArmor</li>
          <li>WotF_ElvenFlowerWreath</li>
          <li>WotF_ElvenSunHat</li>
          <li>WotF_ElvenTravelHood</li>
          <li>WotF_EntropyCirclet</li>
          <li>WotF_ElvenWarCrown</li>
        </apparelList>
        <!--
          Biotech: an elf may only carry its own xenotype or the baseliner
          (技术/01-种族与派系实现.md:25).

          HAR copies xenotypeList into this race's whiteXenotypeList during ResolveReferences
          (erdelf/AlienRaces@b715c63ea7 Source/AlienRace/AlienRace/ThingDef_AlienRace.cs:252-256).
          CanUseXenotype (:1079-1088) answers true only for that list while
          onlyUseRaceRestrictedXenotypes is set, and Pawn_GeneTracker.SetXenotype is prefixed with it
          (Source/AlienRace/AlienRace/HarmonyPatches.cs:960-961) - a false result skips the whole
          vanilla method. Every other xenotype, Sanguophage included, is therefore refused:
          SetXenotype leaves the tracker untouched and generation never assigns it.

          Baseliner goes in whiteXenotypeList, NOT xenotypeList: every xenotypeList entry is added to the
          global xenotypeRestricted set (ThingDef_AlienRace.cs:252-255), and CanUseXenotype then answers
          false for every race whose own whitelist lacks it (:1084-1085) - including vanilla humans, whose
          ThingDef is not a ThingDef_AlienRace. Listing Baseliner there would block SetXenotype(Baseliner)
          on all humans. The elf xenotype in xenotypeList is intended: it keeps other races from taking it.
          The reference mod (workshop 3292351432, Races_Axolotllike.xml:817-820) writes Baseliner the same way.

          Why Baseliner is allowed at all: xenogerm implantation resets the tracker through
          GeneUtility.ImplantXenogermItem, which calls SetXenotype(XenotypeDefOf.Baseliner) before
          adding the pack's genes (RimWorld/GeneUtility.cs:207-222), and extraction does the same when
          reimplanting would kill the pawn (:194-200). With Baseliner refused, the prefix would skip
          SetXenotype, ClearXenogenes would never run, and a second pack would stack on the first
          instead of replacing it. Its genes are none, so a baseliner elf is a plain, gene-less elf.

          Generation weights are separate from this list: the xenotypeSet on the pawn kinds and on
          WotF_PlayerElf still offers only WotF_ElfXenotype at weight 1, and XenotypeSet.BaselinerChance
          is 1 - sum(chances) = 0 (RimWorld/XenotypeSet.cs:13-32), so nothing rolls a baseliner here.

          Without Biotech none of this runs: no XenotypeDef exists, SetXenotype is gated by
          ModLister.CheckBiotech (RimWorld/Pawn_GeneTracker.cs:479-482) and both list entries are
          dropped by MayRequire, so the flag has no caller to affect.
        -->
        <onlyUseRaceRestrictedXenotypes>true</onlyUseRaceRestrictedXenotypes>
        <xenotypeList>
          <li MayRequire="Ludeon.RimWorld.Biotech">WotF_ElfXenotype</li>
        </xenotypeList>
        <whiteXenotypeList>
          <li MayRequire="Ludeon.RimWorld.Biotech">Baseliner</li>
        </whiteXenotypeList>

        <blackGeneTags>
          <li>Ears</li>
          <li>Tail</li>
          <li>BodyType</li>
          <li>Furskin</li>
          <li>HairStyle</li>
          <li>SkinColorOverride</li>
        </blackGeneTags>
        <blackEndoCategories>
          <li>Melanin</li>
        </blackEndoCategories>
      </raceRestriction>
    </alienRace>
  </AlienRace.ThingDef_AlienRace>

  <PawnKindDef ParentName="BasePlayerPawnKind">
    <defName>WotF_Elf_Colonist</defName>
    <label>elf</label>
    <race>WotF_Elf</race>
    <!--
      Vanilla fills ForcedXenotype with Baseliner for starting pawns and clears it only for a kind
      that carries a xenotypeSet (RimWorld/ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs.cs:118-130,
      Verse/StartingPawnUtility.cs:53); HAR then replaces that literal with PickStartingPawnConfig,
      which resolves currentStartingRequest.ForcedXenotype ?? Baseliner (HarmonyPatches.cs:3761-3766),
      and PawnGenerator passes the forced value straight into SetXenotype (Verse/PawnGenerator.cs:1699-1701,
      :1619-1624). Because WotF_Scenario_Elf uses the plain starting-pawns scen part, nothing clears the
      baseliner on that path; Patch_ElfStartingXenotype (Source/WhisperOfTheForest/Race/ElfStartingXenotype.cs)
      replaces it with WotF_ElfXenotype for this kind while the player faction is WotF_PlayerElf.
      The xenotypeSet below is what every other path rolls when nothing is forced
      (Verse/PawnGenerator.cs:1746-1794): one entry at weight 1 leaves the baseliner share 1-1=0.
    -->
    <xenotypeSet>
      <xenotypeChances>
        <WotF_ElfXenotype MayRequire="Ludeon.RimWorld.Biotech">1</WotF_ElfXenotype>
      </xenotypeChances>
    </xenotypeSet>
    <fixedGender>Female</fixedGender>
    <nameMakerFemale>WotF_ElfNames</nameMakerFemale>
    <!-- A player defaultFactionDef is what lists this kind among the starting-pawn kinds
         (RimWorld/ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs.cs:16). Backstories come from
         backstoryFiltersOverride below, not from the faction (RimWorld/PawnBioAndNameGenerator.cs:269-271). -->
    <defaultFactionDef>WotF_PlayerElf</defaultFactionDef>
    <backstoryFiltersOverride>
      <li>
        <categoriesChildhood><li>GreenCourt_Childhood</li></categoriesChildhood>
        <categoriesAdulthood>
          <li>GreenCourt_General</li>
          <li>GreenCourt_Range</li>
          <li>GreenCourt_Melee</li>
          <li>GreenCourt_Caster</li>
          <li>GreenCourt_Leader</li>
        </categoriesAdulthood>
      </li>
    </backstoryFiltersOverride>
    <initialResistanceRange>13~21</initialResistanceRange>
    <apparelRequired>
      <li>WotF_Spellbook_Apprentice</li>
    </apparelRequired>
  </PawnKindDef>

</Defs>
