<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Elven everyday clothing, first batch (技术/02-魔法实现.md:145-149 「精灵本族基础服饰与头盔位分层表」,
    技术/09-美术资产清单.md:54-58 A1-A6).

    All pieces are elven-cut only: Elf.xml lists them in raceRestriction/apparelList, and their worn
    graphics are the 512 canvas of the placeholder body, so the 5 body-type x 3 direction files exist
    for the checker while the race itself only uses Thin (see Elf.xml bodyTypes).

    Numbers are placeholders copied from the vanilla Def named in each block
    (brief: 表里没给数值的统计量参照同层位、同定位的原版服饰取值，写明「占位，参照原版 X」).
    Recipes are generated by <recipeMaker>; no researchPrerequisite this round so every piece is
    craftable straight away. Materials are declared once, by stuffCategories.

    apparel/tags (2026-11-14, court loadout round): every elven garment carries WotF_Elven plus one
    role tag, so a PawnKindDef can name a pool without listing each Def. The role tags are
    WotF_CourtDress (everyday OnSkin wear), WotF_CourtCloak (Shell), WotF_CourtHead (Overhead) and
    WotF_CourtArmor (Middle/Shell armor). Only PawnApparelGenerator (apparelTags / specificApparel-
    Requirements) and StockGenerator_MarketValue.apparelTag read these; no vanilla PawnKindDef lists
    them, so no other faction starts wearing elven clothes.
  -->

  <!-- 占位，参照原版 Apparel_TribalA：同层位（OnSkin）、同覆盖（Torso+Legs）、布/皮连身服。 -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>WotF_ElvenDressTraditional_I</defName>
    <label>elven traditional dress I</label>
    <description>A close-cut elven dress that covers the torso and legs in one piece. Woven from cloth or leather, it insulates against both heat and cold, and is the everyday wear of forest villages.</description>
    <techLevel>Neolithic</techLevel>
    <graphicData>
      <texPath>Apparel/TraditionalDressI/TraditionalDressI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>60</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>1800</WorkToMake>
      <Mass>0.5</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.55</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.55</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Legs</li>
      </bodyPartGroups>
      <tags>
        <li>WotF_Elven</li>
        <li>WotF_CourtDress</li>
      </tags>
      <wornGraphicPath>Apparel/TraditionalDressI/TraditionalDressI</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>CraftingSpot</li>
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <displayPriority>210</displayPriority>
    </recipeMaker>
    <tradeTags>
      <li>BasicClothing</li>
    </tradeTags>
  </ThingDef>

