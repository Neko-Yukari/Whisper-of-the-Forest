  <!--
    占位，参照原版 Apparel_Duster：同层位（Shell）、同覆盖（除头全身）、同定位（野外风霜防护）。
    CarryingCapacity +20：设定表原文「携带负重 +20」。
    <shellRenderedBehindHead>true</shellRenderedBehindHead>：设定写「Shell（带背层）」，原版 Apparel_Cape
    用同一开关在头后渲染袍身，不需要额外的 BG 贴图节点；裁定第 3 条即按此落地。
  -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>WotF_ElvenTravelCloak</defName>
    <label>elven travel cloak</label>
    <description>A long travelling cloak with a strap for a travel pack, cut to cover everything but the head. It sheds wind, rain and sun, and the pack straps let the wearer carry more than usual.</description>
    <techLevel>Neolithic</techLevel>
    <graphicData>
      <texPath>Apparel/TravelCloak/TravelCloak</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>80</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToMake>10000</WorkToMake>
      <Mass>2</Mass>
      <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.60</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.85</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <CarryingCapacity>20</CarryingCapacity>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <tags>
        <li>WotF_Elven</li>
        <li>WotF_CourtCloak</li>
      </tags>
      <wornGraphicPath>Apparel/TravelCloak/TravelCloak</wornGraphicPath>
      <layers>
        <li>Shell</li>
      </layers>
      <shellRenderedBehindHead>true</shellRenderedBehindHead>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>CraftingSpot</li>
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <displayPriority>215</displayPriority>
    </recipeMaker>
    <tradeTags>
      <li>BasicClothing</li>
    </tradeTags>
  </ThingDef>

</Defs>
