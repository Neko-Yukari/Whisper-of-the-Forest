    <graphicData>
      <texPath>Apparel/SunHat/SunHat</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>25</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
      <li>Woody</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToMake>1800</WorkToMake>
      <Mass>0.14</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.10</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.50</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>0.8</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <SocialImpact>0.10</SocialImpact>
    </equippedStatOffsets>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <tags>
        <li>WotF_Elven</li>
        <li>WotF_CourtHead</li>
      </tags>
      <wornGraphicPath>Apparel/SunHat/SunHat</wornGraphicPath>
      <renderSkipFlags>
        <li>None</li>
      </renderSkipFlags>
      <layers>
        <li>Overhead</li>
      </layers>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>CraftingSpot</li>
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <displayPriority>231</displayPriority>
    </recipeMaker>
    <tradeTags>
      <li>BasicClothing</li>
    </tradeTags>
  </ThingDef>

  <!--
    占位，参照原版 Apparel_CowboyHat：同层位（Overhead）、帽位用料与工时同档，覆盖部位改为 FullHead。
    保暖 0.30/0.30 是占位：原版 Apparel_CowboyHat 为 0.10/0.50，兜帽整头包裹，取中间量级。
  -->
  <ThingDef ParentName="HatMakeableBase">
    <defName>WotF_ElvenTravelHood</defName>
    <label>elven travel hood</label>
    <description>A deep hood made to match the travel cloak. It covers the whole head against wind, cold and sun while leaving the face and the tips of the hair free.</description>
    <techLevel>Neolithic</techLevel>
    <graphicData>
      <texPath>Apparel/TravelHood/TravelHood</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>35</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToMake>2400</WorkToMake>
      <Mass>0.20</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.30</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.30</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1</EquipDelay>
    </statBases>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <tags>
        <li>WotF_Elven</li>
        <li>WotF_CourtHead</li>
      </tags>
      <wornGraphicPath>Apparel/TravelHood/TravelHood</wornGraphicPath>
      <renderSkipFlags>
        <li>None</li>
      </renderSkipFlags>
      <layers>
        <li>Overhead</li>
      </layers>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>CraftingSpot</li>
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <displayPriority>232</displayPriority>
    </recipeMaker>
    <tradeTags>
      <li>BasicClothing</li>
    </tradeTags>
  </ThingDef>

  <!--
    占位，参照原版 Apparel_AdvancedHelmet：同为金属头盔，取命中点、工时、重量、护甲倍率与装备时间。
    stuffCategories 只有 Metallic 一处声明材料范围；配方沿用 ArmorHelmetMakeableBase 的过滤，
    实际可选钢/精灵钢/精金/秘银。
  -->
  <ThingDef ParentName="ArmorHelmetMakeableBase">
    <defName>WotF_ElvenWarCrown</defName>
    <label>elven war crown</label>
    <description>A winged war crown forged from a single metal. It guards the whole head like a heavy helmet while the open face keeps the wearer's expression and hair visible.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Apparel/WarCrown/WarCrown</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1, 1)</drawSize>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <costStuffCount>40</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToMake>8000</WorkToMake>
      <Mass>1.2</Mass>
      <StuffEffectMultiplierArmor>0.7</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <tags>
        <li>WotF_Elven</li>
        <li>WotF_CourtHead</li>
        <li>WotF_CourtArmor</li>
      </tags>
      <wornGraphicPath>Apparel/WarCrown/WarCrown</wornGraphicPath>
      <renderSkipFlags>
        <li>None</li>
      </renderSkipFlags>
      <layers>
        <li>Overhead</li>
      </layers>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>WotF_ManaWorkbench</li>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>233</displayPriority>
    </recipeMaker>
    <tradeTags>
      <li>Clothing</li>
      <li>Armor</li>
    </tradeTags>
  </ThingDef>

</Defs>
