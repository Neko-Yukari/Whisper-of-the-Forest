<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Elven headgear, first batch (技术/02-魔法实现.md:154-157, 技术/09-美术资产清单.md:63-66 H1-H4).

    All four sit on the Overhead layer with <renderSkipFlags>None</renderSkipFlags> so hair stays
    visible: Verse/PawnRenderTree.cs:292-314 hides Hair for UpperHead and Hair+Beard+Eyes for FullHead
    whenever renderSkipFlags is absent, and the table says 头盔位均不隐藏头发贴图.

    Numbers are placeholders copied from the vanilla Def named in each block. No researchPrerequisite
    this round. 花环/阳帽 give SocialImpact only: vanilla has no apparel stat that grants mood, so a
    mood bonus is left to a later C# round instead of faking it with another stat (裁定第 7 条).
  -->

  <!-- 占位，参照原版 Apparel_CowboyHat：同层位（Overhead）、同覆盖（UpperHead）。SocialImpact +0.10 同源。 -->
  <ThingDef ParentName="HatMakeableBase">
    <defName>WotF_ElvenFlowerWreath</defName>
    <label>elven flower wreath</label>
    <description>A wreath of living leaves and small flowers worn across the brow. It leaves the hair and face untouched, and the wearer makes a slightly better impression in conversation. A mood bonus is not implemented yet.</description>
    <techLevel>Neolithic</techLevel>
    <graphicData>
      <texPath>Apparel/FlowerWreath/FlowerWreath</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>25</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
      <li>Woody</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToMake>1800</WorkToMake>
      <Mass>0.14</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.10</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.50</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>0.8</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <SocialImpact>0.10</SocialImpact>
    </equippedStatOffsets>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <tags>
        <li>WotF_Elven</li>
        <li>WotF_CourtHead</li>
      </tags>
      <wornGraphicPath>Apparel/FlowerWreath/FlowerWreath</wornGraphicPath>
      <renderSkipFlags>
        <li>None</li>
      </renderSkipFlags>
      <layers>
        <li>Overhead</li>
      </layers>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>CraftingSpot</li>
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <displayPriority>230</displayPriority>
    </recipeMaker>
    <tradeTags>
      <li>BasicClothing</li>
    </tradeTags>
  </ThingDef>

  <!-- 占位，参照原版 Apparel_CowboyHat：同层位、同覆盖。SocialImpact +0.10 同源。 -->
