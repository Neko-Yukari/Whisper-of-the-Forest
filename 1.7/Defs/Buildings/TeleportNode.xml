<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>WotF_TeleportNode</defName>
    <label>teleport node</label>
    <description>A heavy rune-cut anchor. A teleport rite performed at the altar can send nearby colonists here.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2520</uiOrder>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.2</fillPercent>
    <pathCost>14</pathCost>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <selectable>true</selectable>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <graphicData>
      <texPath>Buildings/ManaNode</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>10</Beauty>
    </statBases>
    <costList>
      <Steel>200</Steel>
      <Plasteel>30</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <placeWorkers>
      <li>PlaceWorker_GlowRadius</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(140,120,255,0)</glowColor>
      </li>
      <li Class="WhisperOfTheForest.Rituals.CompProperties_TeleportNode" />
    </comps>
  </ThingDef>

</Defs>
