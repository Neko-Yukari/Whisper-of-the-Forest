<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Shared sentence skeleton for BattleLogEntry_SpellDamage.
    Reuses vanilla Combat_WoundIncludes (destroyed_targets / damaged_targets) and
    Combat_DeflectIncludes (scraped_present / scraped_past); each damaging effect
    includes this pack and supplies only its own flavor nouns and verbs.
  -->
  <RulePackDef>
    <defName>WotF_CombatLog_SpellDamageBase</defName>
    <include>
      <li>Combat_WoundIncludes</li>
      <li>Combat_DeflectIncludes</li>
    </include>
    <rulePack>
      <rulesStrings>
        <li>r_logentry(INITIATOR_missing!=True,deflected!=True)->[INITIATOR_definite]'s [spell_noun] [destroyed_past] [RECIPIENT_definite]'s [destroyed_targets].</li>
        <li>r_logentry(INITIATOR_missing!=True,deflected!=True)->[RECIPIENT_definite]'s [destroyed_targets] was [destroyed_past] by [INITIATOR_definite]'s [spell_noun].</li>
        <li>r_logentry(INITIATOR_missing!=True,deflected!=True,p=3)->[INITIATOR_definite]'s [spell_noun] [destroyed_past] [RECIPIENT_definite]'s [destroyed_targets] and [damaged_past] [RECIPIENT_possessive] [damaged_targets].</li>
        <li>r_logentry(INITIATOR_missing!=True,deflected!=True,recipient_part_destroyed_count==0)->[INITIATOR_definite]'s [spell_noun] [damaged_past] [RECIPIENT_definite]'s [damaged_targets].</li>
        <li>r_logentry(INITIATOR_missing!=True,deflected!=True,recipient_part_destroyed_count==0)->[INITIATOR_definite] struck [RECIPIENT_definite] with [spell_noun], [damaged_present] [RECIPIENT_possessive] [damaged_targets].</li>
        <li>r_logentry(INITIATOR_missing!=True,deflected!=True,recipient_part_destroyed_count==0)->[RECIPIENT_definite]'s [damaged_targets] was [damaged_past] by [INITIATOR_definite]'s [spell_noun].</li>
        <li>r_logentry(INITIATOR_missing!=True,deflected!=True,recipient_part_count==0)->[INITIATOR_definite]'s [spell_noun] [damaged_past] [RECIPIENT_definite].</li>
        <li>r_logentry(INITIATOR_missing!=True,deflected==True)->[INITIATOR_definite]'s [spell_noun] hit [RECIPIENT_definite][deflected_part_opt], [scraped_present] harmlessly off [RECIPIENT_possessive] armor.</li>

        <li>r_logentry(INITIATOR_missing==True,deflected!=True)->A [spell_noun] [destroyed_past] [RECIPIENT_definite]'s [destroyed_targets].</li>
        <li>r_logentry(INITIATOR_missing==True,deflected!=True,p=3)->A [spell_noun] [destroyed_past] [RECIPIENT_definite]'s [destroyed_targets] and [damaged_past] [RECIPIENT_possessive] [damaged_targets].</li>
        <li>r_logentry(INITIATOR_missing==True,deflected!=True,recipient_part_destroyed_count==0)->A [spell_noun] [damaged_past] [RECIPIENT_definite]'s [damaged_targets].</li>
        <li>r_logentry(INITIATOR_missing==True,deflected!=True,recipient_part_count==0)->A [spell_noun] [damaged_past] [RECIPIENT_definite].</li>
        <li>r_logentry(INITIATOR_missing==True,deflected==True)->A [spell_noun] hit [RECIPIENT_definite][deflected_part_opt], [scraped_present] harmlessly off [RECIPIENT_possessive] armor.</li>

        <li>deflected_part_opt-></li>
        <li>deflected_part_opt(recipient_part_damaged0_outside==True)->'s [recipient_part_damaged0_label]</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

