<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Grove Shield Dome audio -->
  <SoundDef>
    <defName>WotF_Sound_ShieldDome_Activate</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Shields/WotF_Shield_Dome_Activate</clipPath>
          </li>
        </grains>
        <volumeRange>34~40</volumeRange>
        <pitchRange>0.96~1.04</pitchRange>
        <distRange>15~55</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>WotF_Sound_ShieldDome_Hit</defName>
    <context>MapOnly</context>
    <maxSimultaneous>5</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Shields/WotF_Shield_Dome_Hit</clipPath>
          </li>
        </grains>
        <volumeRange>28~34</volumeRange>
        <pitchRange>0.93~1.08</pitchRange>
        <distRange>12~48</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>WotF_Sound_ShieldDome_Break</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
