  </SoundDef>

  <!-- Subtle friendly projectile pass-through phase shimmer whisper -->
  <SoundDef>
    <defName>WotF_Sound_Shield_PassThrough</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
