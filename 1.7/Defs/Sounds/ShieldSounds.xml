  <SoundDef>
    <defName>WotF_Sound_PlanarShield_Hit</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Shields/WotF_Shield_Planar_Hit_01</clipPath>
          </li>
          <li Class="AudioGrain_Clip">
            <clipPath>Shields/WotF_Shield_Planar_Hit_02</clipPath>
