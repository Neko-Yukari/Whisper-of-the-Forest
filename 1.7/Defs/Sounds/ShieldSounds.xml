<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Grove Shield Dome audio -->
  <SoundDef>
    <defName>WotF_Sound_ShieldDome_Activate</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Shields/WotF_Shield_Dome_Activate</clipPath>
          </li>
        </grains>
        <volumeRange>36~44</volumeRange>
        <pitchRange>0.97~1.03</pitchRange>
        <distRange>16~68</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>WotF_Sound_ShieldDome_Hit</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Shields/WotF_Shield_Dome_Hit_01</clipPath>
          </li>
          <li Class="AudioGrain_Clip">
            <clipPath>Shields/WotF_Shield_Dome_Hit_02</clipPath>
          </li>
          <li Class="AudioGrain_Clip">
            <clipPath>Shields/WotF_Shield_Dome_Hit_03</clipPath>
          </li>
        </grains>
        <volumeRange>26~34</volumeRange>
        <pitchRange>0.93~1.04</pitchRange>
        <distRange>12~52</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>WotF_Sound_ShieldDome_Break</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Shields/WotF_Shield_Dome_Break</clipPath>
          </li>
        </grains>
        <volumeRange>38~46</volumeRange>
        <pitchRange>0.95~1.04</pitchRange>
        <distRange>16~68</distRange>
      </li>
    </subSounds>
  </SoundDef>

