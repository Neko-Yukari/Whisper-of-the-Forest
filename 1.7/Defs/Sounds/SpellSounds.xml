      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Spells/WotF_Cast_Vitality_Release</clipPath>
          </li>
        </grains>
        <volumeRange>38~42</volumeRange>
        <pitchRange>0.96~1.05</pitchRange>
        <distRange>14~56</distRange>
      </li>
    </subSounds>
  </SoundDef>

