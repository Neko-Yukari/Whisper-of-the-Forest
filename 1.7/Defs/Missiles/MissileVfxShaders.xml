<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Additive world particle for flying missiles: same particle program as RimUnity_ParticleAdditive,
       but without depth testing so terrain, grass and tree canopies cannot hide the comet or its trail. -->
  <ShaderDef>
    <defName>WotF_ParticleAdditiveNoDepth</defName>
    <shaderProgram>
      <vertexShaderFileName>RimUnity/Particle.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>RimUnity/Particle.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3000</renderQueue>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>SrcAlpha</blendSrcFactor>
      <blendDstFactor>One</blendDstFactor>
    </shaderProgram>
  </ShaderDef>
</Defs>
