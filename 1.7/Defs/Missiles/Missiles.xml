<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Force damage used by arcane missiles when the impact mode is Damage or Explode. -->
  <DamageDef ParentName="Bullet">
    <defName>WotF_ArcaneMissileDamage</defName>
    <label>blunt</label>
    <description>Heavy concussive force that crushes rather than cuts.</description>
    <workerClass>WhisperOfTheForest.Spells.DamageWorker_SpellArcaneForce</workerClass>
    <deathMessage>{0} was crushed to death by blunt force.</deathMessage>
    <hediff>Bruise</hediff>
    <hediffSolid>Crack</hediffSolid>
    <armorCategory>Blunt</armorCategory>
    <makesAnimalsFlee>false</makesAnimalsFlee>
    <soundExplosion>WotF_Sound_Effect_Explosion</soundExplosion>
    <combatLogRules>Damage_Bomb</combatLogRules>
  </DamageDef>

  <!--
    Native carrier for every arcane missile (Phase 5 migration). Each missile is a real spawned
    Verse.Projectile thing, so the game owns spawn registration, ticking (TickInterval with the
    vanilla 1-visible/15-offscreen update rate), saving and destruction. The mod only supplies
    the homing step and the hit payload; drawing is owned by the selected visual backend, so the
    thing itself is never drawn (drawerType None). The projectile block exists so the def is a
    valid BaseBullet child and any vanilla read of def.projectile stays sane; the vanilla
    straight-line flight and lifetime fields are not used by Projectile_ArcaneMissiles.
  -->
  <ThingDef ParentName="BaseBullet">
    <defName>WotF_ArcaneMissileProjectile</defName>
    <label>arcane missile</label>
    <thingClass>WhisperOfTheForest.Missiles.Projectile_ArcaneMissiles</thingClass>
    <drawerType>None</drawerType>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <texPath>Missiles/ArcaneMissiles</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <projectile>
      <damageDef>WotF_ArcaneMissileDamage</damageDef>
      <damageAmountBase>7</damageAmountBase>
      <stoppingPower>0</stoppingPower>
      <speed>13</speed>
    </projectile>
  </ThingDef>

  <!-- Visual effects of the arcane missiles: Vfx Defs like the railgun's, not a second visual system.
       A trail Def names the backend worker and the impact Def it hands over to; the impact Def names
       only its worker. The Vfx layer owns both lifetimes. Def names are unchanged, so saved volleys
       keep pointing at a def that still exists.
       Mod-defined Def subclasses must use their fully qualified type name as the XML root tag; the
       short name is only resolvable for Verse/RimWorld types. -->
  <WhisperOfTheForest.Missiles.ArcaneMissileRimLumenVfxDef>
    <defName>WotF_Visual_RimLumen</defName>
    <label>arcane missiles (RimLumen HDR)</label>
    <workerClass>WhisperOfTheForest.Missiles.ArcaneMissileRimLumenVfxWorker</workerClass>
    <lifetime>FollowThing</lifetime>
    <impactVisualDefName>WotF_Vfx_MissileImpact_RimLumen</impactVisualDefName>
    <launchSound>WotF_Sound_Missile_Launch</launchSound>
    <headCoreRadiusFactor>0.22</headCoreRadiusFactor>
    <headHaloRadiusFactor>0.46</headHaloRadiusFactor>
    <headStretchLengthFactor>0.72</headStretchLengthFactor>
    <trailWidthFactor>0.34</trailWidthFactor>
    <trailMinVertexDistance>0.09</trailMinVertexDistance>
    <trailMaxPoints>48</trailMaxPoints>
    <wakeRatePerSecond>26</wakeRatePerSecond>
    <wakeLifetimeMin>0.20</wakeLifetimeMin>
    <wakeLifetimeMax>0.38</wakeLifetimeMax>
    <wakeSizeMinFactor>0.085</wakeSizeMinFactor>
    <wakeSizeMaxFactor>0.165</wakeSizeMaxFactor>
    <wakeDrag>5.4</wakeDrag>
    <wakeTurbulence>0.75</wakeTurbulence>
    <lightRadius>2.2</lightRadius>
    <lightHeightCells>1.25</lightHeightCells>
    <lightIntensity>0.28</lightIntensity>
    <hdrHeadMultiplier>1.45</hdrHeadMultiplier>
    <hdrTrailMultiplier>1.35</hdrTrailMultiplier>
    <hdrWakeMultiplier>1.25</hdrWakeMultiplier>
    <ribbonEdgePower>1.65</ribbonEdgePower>
    <drainFadeSeconds>0.12</drainFadeSeconds>
    <drainDurationSeconds>0.16</drainDurationSeconds>
  </WhisperOfTheForest.Missiles.ArcaneMissileRimLumenVfxDef>

  <WhisperOfTheForest.Missiles.ArcaneMissileVisualDef>
    <defName>WotF_Visual_Native</defName>
    <label>arcane missiles (native flecks)</label>
    <workerClass>WhisperOfTheForest.Missiles.ArcaneMissileNativeVfxWorker</workerClass>
    <lifetime>FollowThing</lifetime>
    <impactVisualDefName>WotF_Vfx_MissileImpact_Native</impactVisualDefName>
    <launchSound>WotF_Sound_Missile_Launch</launchSound>
  </WhisperOfTheForest.Missiles.ArcaneMissileVisualDef>

  <WhisperOfTheForest.Missiles.ArcaneMissileImpactRimLumenVfxDef>
    <defName>WotF_Vfx_MissileImpact_RimLumen</defName>
    <label>arcane missile impact (RimLumen HDR)</label>
    <workerClass>WhisperOfTheForest.Missiles.ArcaneMissileRimLumenImpactVfxWorker</workerClass>
    <touchSound>WotF_Sound_Missile_Touch</touchSound>
    <flashDurationSeconds>0.20</flashDurationSeconds>
    <holdDurationSeconds>0.60</holdDurationSeconds>
    <flashPeakRadiusFactor>0.85</flashPeakRadiusFactor>
    <sparkBurstCount>16</sparkBurstCount>
    <sparkSpeedMin>1.4</sparkSpeedMin>
    <sparkSpeedMax>3.4</sparkSpeedMax>
    <sparkLifetimeMin>0.18</sparkLifetimeMin>
    <sparkLifetimeMax>0.36</sparkLifetimeMax>
    <sparkSizeMinFactor>0.068</sparkSizeMinFactor>
    <sparkSizeMaxFactor>0.13</sparkSizeMaxFactor>
    <sparkDrag>6.2</sparkDrag>
    <emberBurstCount>16</emberBurstCount>
    <emberSpeedMin>0.25</emberSpeedMin>
    <emberSpeedMax>1.05</emberSpeedMax>
    <emberLifetimeMin>0.28</emberLifetimeMin>
    <emberLifetimeMax>0.56</emberLifetimeMax>
    <emberSizeMinFactor>0.082</emberSizeMinFactor>
    <emberSizeMaxFactor>0.165</emberSizeMaxFactor>
    <emberDrag>4.6</emberDrag>
    <emberTurbulence>1.20</emberTurbulence>
    <distortionRadius>1.0</distortionRadius>
    <distortionStrength>0.024</distortionStrength>
    <distortionThickness>0.20</distortionThickness>
    <distortionSpeed>4.8</distortionSpeed>
    <distortionDurationSeconds>0.18</distortionDurationSeconds>
    <lightRadius>2.5</lightRadius>
    <lightHeightCells>1.25</lightHeightCells>
    <lightPeakIntensity>0.60</lightPeakIntensity>
    <lightDurationSeconds>0.22</lightDurationSeconds>
    <hdrFlashMultiplier>1.72</hdrFlashMultiplier>
    <hdrSparkMultiplier>1.85</hdrSparkMultiplier>
    <hdrEmberMultiplier>1.80</hdrEmberMultiplier>
    <ribbonEdgePower>1.65</ribbonEdgePower>
  </WhisperOfTheForest.Missiles.ArcaneMissileImpactRimLumenVfxDef>

  <WhisperOfTheForest.Vfx.VfxDef>
    <defName>WotF_Vfx_MissileImpact_Native</defName>
    <label>arcane missile impact (native flecks)</label>
    <workerClass>WhisperOfTheForest.Missiles.ArcaneMissileNativeImpactVfxWorker</workerClass>
  </WhisperOfTheForest.Vfx.VfxDef>

</Defs>
