<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 寻踪：2 阶祭坛的界域阵（Domain），5×5 翠叶粉笔环，沿用现有 5×5 绿环的配色。
       120 魔源 / 600 tick 是任务书定值，其余为占位。主持者在这里二选一：通用遗迹或核心遗迹。 -->
  <WhisperOfTheForest.Rituals.RitualDef>
    <defName>WotF_Ritual_SeekRuin</defName>
    <tier>2</tier>
    <family>Domain</family>
    <label>rite of seeking</label>
    <description>The caster traces a green chalk ring around the altar and asks the forest where an old ruin lies. The colony chooses whether to seek an overgrown forest ruin or an ancient engineering station. Only one unclaimed ruin may be outstanding at a time.</description>
    <ringSize>5</ringSize>
    <chalkColor>Green</chalkColor>
    <manaCost>120</manaCost>
    <durationTicks>600</durationTicks>
    <effectRadius>12.9</effectRadius>
    <chooseRuinType>true</chooseRuinType>
    <effectWorkerClass>WhisperOfTheForest.AncientRuins.RitualEffect_SeekRuin</effectWorkerClass>
    <ruinOptions>
      <li>
        <quest>WotF_RuinSeek_Common</quest>
        <sitePart>WotF_Site_Ruin_Common</sitePart>
        <threatPointsFactor>0.8</threatPointsFactor>
      </li>
      <li>
        <quest>WotF_RuinSeek_Core</quest>
        <sitePart>WotF_Site_Ruin_Core</sitePart>
        <threatPointsFactor>1.4</threatPointsFactor>
      </li>
    </ruinOptions>
  </WhisperOfTheForest.Rituals.RitualDef>
</Defs>
