<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 寻踪：2 阶祭坛的界域阵（Domain），5×5 翠叶粉笔环，沿用现有 5×5 绿环的配色。
       120 魔源 / 600 工作量是任务书定值，其余为占位。指向唯一的古老工程遗迹，同时只允许存在一处未清理遗迹。 -->
  <WhisperOfTheForest.Rituals.RitualDef ParentName="WotF_WorkRitualBase">
    <defName>WotF_Ritual_SeekRuin</defName>
    <tier>2</tier>
    <family>Domain</family>
    <label>rite of seeking</label>
    <description>The caster traces a green chalk ring around the altar and asks the forest where an ancient engineering ruin lies. Only one unclaimed ruin may be outstanding at a time.</description>
    <ringSize>5</ringSize>
    <chalkColor>Green</chalkColor>
    <manaCost>120</manaCost>
    <workAmount>600</workAmount>
    <effectRadius>12.9</effectRadius>
    <effectWorkerClass>WhisperOfTheForest.AncientRuins.RitualEffect_SeekRuin</effectWorkerClass>
    <researchPrerequisite>WotF_Research_Ritual_SeekRuin</researchPrerequisite>
    <ruinTarget>
      <quest>WotF_RuinSeek_Core</quest>
      <sitePart>WotF_Site_Ruin_Core</sitePart>
      <threatPointsFactor>1.4</threatPointsFactor>
    </ruinTarget>
  </WhisperOfTheForest.Rituals.RitualDef>
</Defs>
