    <defName>WotF_Caravan_GreenCourt</defName>
    <category>Court goods</category>
    <commonality>1</commonality>
    <requestable>true</requestable>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>600~2000</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineHerbal</thingDef>
        <countRange>10~25</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>WotF_Chalk</thingDef>
        <countRange>20~40</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>WotF_ManaVial</thingDef>
        <countRange>2~5</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>WotF_LivingWood</thingDef>
        <countRange>40~90</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>WotF_ElvenSteel</thingDef>
        <countRange>8~20</countRange>
      </li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff">
        <thingDef>WotF_ElvenLongsword</thingDef>
        <stuff>WotF_ElvenSteel</stuff>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>WotF_ElvenLongbow</thingDef>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>WotF_SpellStaffShort</thingDef>
        <countRange>1~2</countRange>
      </li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff">
        <thingDef>WotF_SpellStaff</thingDef>
        <stuff>WotF_LivingWood</stuff>
        <countRange>-1~1</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>WotF_TerrainStride</thingDef>
        <countRange>1~2</countRange>
      </li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff">
        <thingDef>WotF_EntropyCirclet</thingDef>
        <stuff>WotF_ElvenSteel</stuff>
        <countRange>1~2</countRange>
      </li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff"><thingDef>WotF_ElvenDressTraditional_I</thingDef><stuff>Cloth</stuff><countRange>1~2</countRange></li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff"><thingDef>WotF_ElvenDressTraditional_II</thingDef><stuff>Cloth</stuff><countRange>1~2</countRange></li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff"><thingDef>WotF_ElvenApronDress</thingDef><stuff>Cloth</stuff><countRange>1~2</countRange></li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff"><thingDef>WotF_ElvenHunterUndershirt</thingDef><stuff>Cloth</stuff><countRange>1~2</countRange></li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff"><thingDef>WotF_ElvenFormalGown</thingDef><stuff>Cloth</stuff><countRange>1~2</countRange></li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff"><thingDef>WotF_ElvenTravelCloak</thingDef><stuff>Cloth</stuff><countRange>1~2</countRange></li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff"><thingDef>WotF_ElvenFlowerWreath</thingDef><stuff>Cloth</stuff><countRange>1~2</countRange></li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff"><thingDef>WotF_ElvenSunHat</thingDef><stuff>Cloth</stuff><countRange>1~2</countRange></li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff"><thingDef>WotF_ElvenTravelHood</thingDef><stuff>Cloth</stuff><countRange>1~2</countRange></li>
      <li Class="WhisperOfTheForest.Court.StockGenerator_SingleDefStuff"><thingDef>WotF_ElvenWarCrown</thingDef><stuff>WotF_ElvenSteel</stuff><countRange>1~2</countRange></li>
      <li Class="StockGenerator_MultiDef">
        <thingDefs>
          <li>WotF_Spellbook_Apprentice</li>
          <li>WotF_Spellbook_Adept</li>
        </thingDefs>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_BuyExpensiveSimple" />
      <li Class="StockGenerator_BuyTradeTag"><tag>Art</tag></li>
    </stockGenerators>
  </TraderKindDef>

